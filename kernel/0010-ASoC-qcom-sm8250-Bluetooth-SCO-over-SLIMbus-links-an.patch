+/*
+ * Rate of the Bluetooth SCO link: 8000 for CVSD, 16000 for mSBC. A parameter
+ * because nothing tells the machine driver which codec the link negotiated.
+ */
+static uint bt_sco_rate = 8000;
+module_param(bt_sco_rate, uint, 0644);
+MODULE_PARM_DESC(bt_sco_rate, "sample rate of the Bluetooth SCO link (8000 CVSD, 16000 mSBC)");
+
 static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
@@ -64,6 +74,21 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 					SNDRV_PCM_HW_PARAM_CHANNELS);
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
 
+	/*
+	 * The Bluetooth SCO link is not 48 kHz stereo like everything else:
+	 * it carries one channel at the rate of its air codec - 8 kHz for
+	 * CVSD, 16 kHz for the wideband one. Forcing the usual figures here
+	 * feeds the chip six times the samples it reads, and the headset gets
+	 * an audio that drifts in and out of sense.
+	 */
+	if (rtd->dai_link->id == SLIMBUS_7_RX ||
+	    rtd->dai_link->id == SLIMBUS_7_TX) {
+		rate->min = rate->max = bt_sco_rate;
+		channels->min = channels->max = 1;
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+		return 0;
+	}
+
 	rate->min = rate->max = 48000;
 	channels->min = channels->max = 2;
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
@@ -71,13 +96,27 @@ static int sm8250_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	return 0;
 }
 
+/*
+ * A BE link can have more than one codec DAI (e.g. two amplifiers sharing
+ * one MI2S bus for a stereo pair, each with its own DAI) - set_fmt() must be
+ * called on every one of them, not just the first, or codecs past index 0
+ * are left running with whatever DAI format they reset-defaulted to.
+ */
+static void mi2s_set_codec_dai_fmt(struct snd_soc_pcm_runtime *rtd, unsigned int codec_dai_fmt)
+{
+	struct snd_soc_dai *codec_dai;
+	int i;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai)
+		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+}
+
 static int sm8250_snd_startup(struct snd_pcm_substream *substream)
 {
