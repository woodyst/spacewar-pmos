From: Danila Tikhonov <danila@mainlining.org>
Subject: [PATCH] arm64: dts: qcom: sm7325-nothing-spacewar: enable WCD9385 audio (adapted to 7.2.2)

Adapted from mainlining/linux danila/spacewar-next b98f40a18fc9 ("WIP: arm64: dts: qcom:
sm7325-nothing-spacewar: Add WCD support") for the sc7280-mainline v7.2.2 tree, whose
spacewar dts already has a &sound node (qcom,sm7325-sndcard + qcom,sm8250-sndcard, I2S to the
TFA9873 amplifiers). The WCD links, MultiMedia2/3 and the audio routing are merged into that
node instead of adding a second one with the nothing,spacewar-sndcard compatible, so the card
keeps the sm8250 driver name its UCM profile is installed under; the mi2s0_* pin overrides are
dropped because that node already configures those pins (pri_mi2s_*).

The links are ordered MultiMedia1, MultiMedia2, MultiMedia3 and then the backends, because the
link order gives the PCM device numbers and the UCM profile expects MultiMedia2 at hw:0,1 and
MultiMedia3 at hw:0,2.

Signed-off-by: Danila Tikhonov <danila@mainlining.org>
[Eduardo: adapted to sc7280-mainline v7.2.2 as described above]
Signed-off-by: Eduardo García-Mádico Portabella <woodyst@gmail.com>
---
--- a/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-nothing-spacewar.dts
@@ -380,6 +380,36 @@
 		regulator-always-on;
 		vin-supply = <&vph_pwr>;
 	};
+
+	wcd9385: audio-codec {
+		compatible = "qcom,wcd9385-codec";
+
+		pinctrl-0 = <&wcd_reset_n>;
+		pinctrl-1 = <&wcd_reset_n_sleep>;
+		pinctrl-names = "default", "sleep";
+
+		reset-gpios = <&tlmm 83 GPIO_ACTIVE_LOW>;
+
+		vdd-rxtx-supply = <&vdd_txrx>;
+		vdd-io-supply = <&vdd_px_wcd9385>;
+		vdd-buck-supply = <&vdd_buck>;
+		vdd-mic-bias-supply = <&vdd_mic_bias>;
+
+		qcom,micbias1-microvolt = <2750000>;
+		qcom,micbias2-microvolt = <2700000>;
+		qcom,micbias3-microvolt = <2750000>;
+		qcom,micbias4-microvolt = <2750000>;
+
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000
+							  500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
 };
 
 &apps_rsc {
@@ -1076,6 +1106,25 @@
 	/delete-property/ power-domains;
 };
 
+&lpass_rx_macro {
+	status = "okay";
+};
+
+&lpass_tx_macro {
+	compatible = "qcom,sm7325-lpass-tx-macro",
+		     "qcom,sm8450-lpass-tx-macro"; // txmacro = v9.2
+	status = "okay";
+};
+
+&lpass_va_macro {
+	vdd-micb-supply = <&vreg_bob>;
+
+	/* No DMIC used */
+	qcom,dmic-sample-rate = <4800000>;
+
+	status = "okay";
+};
+
 &mdss {
 	status = "okay";
 };
@@ -1116,6 +1165,10 @@
 	status = "okay";
 };
 
+
+
+
+
 &pm7325_gpios {
 	gpio-line-names = "NC", /* GPIO_1 */
 			  "PA_THERM3",
@@ -1317,12 +1370,28 @@
 		reg = <PRIMARY_MI2S_RX>;
 		qcom,sd-lines = <1>;
 	};
+
+	dai@113 {
+		reg = <RX_CODEC_DMA_RX_0>;
+	};
+
+	dai@120 {
+		reg = <TX_CODEC_DMA_TX_3>;
+	};
 };
 
 &q6asmdai {
 	dai@0 {
 		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
 	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+
+	dai@2 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
+	};
 };
 
 &qfprom {
@@ -1379,6 +1448,17 @@
 	pinctrl-names = "default",
 			"sleep";
 
+	audio-routing = "IN1_HPHL", "HPHL_OUT",
+			"IN2_HPHR", "HPHR_OUT",
+			"AMIC1", "MIC BIAS1",
+			"AMIC2", "MIC BIAS2",
+			"AMIC3", "MIC BIAS3",
+			"AMIC4", "MIC BIAS4",
+			"TX SWR_INPUT0", "ADC1_OUTPUT",
+			"TX SWR_INPUT1", "ADC2_OUTPUT",
+			"TX SWR_INPUT4", "ADC3_OUTPUT",
+			"TX SWR_INPUT5", "ADC4_OUTPUT";
+
 	mm1-dai-link {
 		link-name = "MultiMedia1";
 
@@ -1387,6 +1467,22 @@
 		};
 	};
 
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+
+	mm3-dai-link {
+		link-name = "MultiMedia3";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+		};
+	};
+
 	i2s-dai-link {
 		link-name = "I2S Playback";
 
@@ -1402,8 +1498,41 @@
 			sound-dai = <&tfa9873_l 0>, <&tfa9873_r 0>;
 		};
 	};
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+
+		cpu {
+			sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+		};
+
+		codec {
+			sound-dai = <&wcd9385 0>, <&swr0 0>, <&lpass_rx_macro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+
+		cpu {
+			sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+		};
+
+		codec {
+			sound-dai = <&wcd9385 1>, <&swr1 0>, <&lpass_tx_macro 0>;
+		};
+
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
 };
 
+
 &spi13 {
 	status = "okay";
 
@@ -1440,6 +1569,28 @@
 	};
 };
 
+&swr0 {
+	status = "okay";
+
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+
+		qcom,tx-port-mapping = <1 2 2 4>;
+	};
+};
+
 &tlmm {
 	/* 56-59: Fingerprint reader (SPI) */
 	gpio-reserved-ranges = <56 4>;
@@ -1524,6 +1675,19 @@
 		bias-pull-down;
 	};
 
+	wcd_reset_n: wcd-reset-n-state {
+		pins = "gpio83";
+		function = "gpio";
+		drive-strength = <8>;
+	};
+
+	wcd_reset_n_sleep: wcd-reset-n-sleep-state {
+		pins = "gpio83";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
 	hst_bt_en: hst-bt-en-state {
 		pins = "gpio85";
 		function = "gpio";
