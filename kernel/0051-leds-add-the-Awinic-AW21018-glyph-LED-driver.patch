From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Garcia-Madico Portabella <woodyst@gmail.com>
Date: Mon, 5 Oct 2026 19:38:00 +0200
Subject: [PATCH] leds: add the Awinic AW21018 glyph LED driver

The Nothing Phone (1) drives the white LEDs of the "glyph" interface on
its back with an AW21018 18-channel LED controller on i2c1.  Model the
whole white strip as a single LED (function "indicator", colour white) so
that it can be used as a notification LED, blinking through the generic
LED pattern trigger.

The initialisation sequence, the per-channel scale table and the global
current are taken from Awinic's reference driver.  The board is PVT (hwid
straps gpio19 and gpio21 read high, as in the vendor "nt,hwid" node),
which selects the "EVT" table and a global current of 160.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../bindings/leds/awinic,aw21018.yaml         |  83 +++++
 drivers/leds/Kconfig                          |  15 +
 drivers/leds/Makefile                         |   1 +
 drivers/leds/leds-aw21018.c                   | 305 ++++++++++++++++++
 4 files changed, 404 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/awinic,aw21018.yaml
 create mode 100644 drivers/leds/leds-aw21018.c

diff --git a/Documentation/devicetree/bindings/leds/awinic,aw21018.yaml b/Documentation/devicetree/bindings/leds/awinic,aw21018.yaml
new file mode 100644
index 000000000..be5730aa5
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/awinic,aw21018.yaml
@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/awinic,aw21018.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW21018 LED controller
+
+maintainers:
+  - Eduardo Garcia-Madico Portabella <woodyst@gmail.com>
+
+description:
+  The Awinic AW21018 is a single-colour matrix LED controller with 18
+  channels, programmed through an I2C interface.
+
+properties:
+  compatible:
+    enum:
+      - awinic,aw21018
+
+  reg:
+    maxItems: 1
+
+  enable-gpios:
+    description: GPIO used to enable the chip.
+    maxItems: 1
+
+  awinic,t0-tables:
+    type: boolean
+    description:
+      Select the channel scale table of the early T0 hardware revision.
+      Boards from EVT onwards (the default) use a different table.
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 0
+
+patternProperties:
+  "^led@[0-9a-f]+$":
+    type: object
+    $ref: common.yaml#
+    unevaluatedProperties: false
+
+    properties:
+      reg:
+        maxItems: 1
+
+    required:
+      - reg
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/leds/common.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led-controller@20 {
+            compatible = "awinic,aw21018";
+            reg = <0x20>;
+            enable-gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
+
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            led@0 {
+                reg = <0>;
+                function = LED_FUNCTION_INDICATOR;
+                color = <LED_COLOR_ID_WHITE>;
+            };
+        };
+    };
+...
diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
