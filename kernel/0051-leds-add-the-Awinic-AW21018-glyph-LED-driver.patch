--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -137,6 +137,21 @@ config LEDS_AW200XX
 	  To compile this driver as a module, choose M here: the module
 	  will be called leds-aw200xx.
 
+config LEDS_AW21018
+	tristate "LED support for Awinic AW21018"
+	depends on LEDS_CLASS
+	depends on I2C
+	help
+	  This option enables support for the Awinic AW21018 (18 channels)
+	  LED controller.
+
+	  On the Nothing Phone (1) the AW21018 drives the white LEDs of the
+	  "glyph" interface on the back; the driver exposes them as a single
+	  white LED that can be used as a notification LED.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called leds-aw21018.
+
 config LEDS_AW2013
 	tristate "LED support for Awinic AW2013"
 	depends on LEDS_CLASS && I2C && OF
