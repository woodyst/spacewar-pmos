diff --git a/sound/soc/qcom/qdsp6/q6voice.c b/sound/soc/qcom/qdsp6/q6voice.c
new file mode 100644
index 000000000..5743acdeb
--- /dev/null
+++ b/sound/soc/qcom/qdsp6/q6voice.c
@@ -0,0 +1,1294 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (c) 2012-2017, The Linux Foundation. All rights reserved.
+// Copyright (c) 2020, Stephan Gerhold
+
+#include <linux/device.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include "q6afe.h"
+#include "q6cvp.h"
+#include "q6cvs.h"
+#include "q6mvm.h"
+#include "q6voice-common.h"
+
+/*
+ * The RX volume step is looked up in an ACDB calibration table that nothing
+ * in this driver loads, so there is no way to know from source alone which
+ * value (if any) an uncalibrated profile accepts. Expose it as a module
+ * parameter rather than guessing a constant.
+ */
+static int rx_volume_step = 4;
+module_param(rx_volume_step, int, 0644);
+MODULE_PARM_DESC(rx_volume_step, "CVP RX volume step for voice calls");
+
+/*
+ * How a call that is already running moves to another device.
+ *
+ * Rebuilding only the vocproc (see q6voice_switch_device()) is what the vendor
+ * driver does, and on this phone it is not enough to go BACK to a Bluetooth
+ * headset: the first move onto the headset ports in a call carries audio, any
+ * later one comes back silent or with the uplink only, with every command
+ * acknowledged. That was measured on real calls, and it did not depend on
+ * what was done with the SCO link. The one thing a call start does that a
+ * move does not is create the whole passive session - MVM, CVS and vocproc -
+ * from scratch. With this set, a move tears the three sessions down and builds
+ * them again against the new ports. Writable, so that both ways can be
+ * compared between calls: /sys/module/q6voice/parameters/switch_full_session
+ */
+static bool switch_full_session = true;
+module_param(switch_full_session, bool, 0644);
+MODULE_PARM_DESC(switch_full_session,
+		 "rebuild MVM, CVS and vocproc (not only the vocproc) when a call changes device");
+
+struct q6voice_path_runtime {
+	struct q6voice_session *sessions[Q6VOICE_SERVICE_COUNT];
+	unsigned int started;
+	/* The ports the live vocproc was built with, to spot a device change. */
+	int cvp_tx_port, cvp_rx_port;
+	/* One forced repeat of the rebuild is pending (see the rekick note). */
+	bool rekick;
+	/* Vendor calibration mapped into the DSP for this call, and what is registered */
+	struct q6voice_cal *cal;
+	bool cvs_cal, cvp_cal;
+	/* The calibration set changed during the call: rebuild with the new one. */
+	bool cal_change;
+};
+
+struct q6voice_path {
+	struct q6voice *v;
+
+	enum q6voice_path_type type;
+	int tx_port, rx_port;
+	/* Serialize access to voice path session */
+	struct mutex lock;
+	struct q6voice_path_runtime *runtime;
+	/* Rebuilds the vocproc when the call is moved to another device. */
+	struct delayed_work switch_work;
+};
+
+/*
+ * The one live instance, so the record trigger below can reach the session.
+ * Only ever set from probe/remove.
+ */
+static struct q6voice *q6voice_live;
+
+/* Defined next to q6voice_set_port, which is what schedules it. */
+static void q6voice_switch_device(struct work_struct *work);
+
+struct q6voice {
+	struct device *dev;
+	struct q6voice_path paths[Q6VOICE_PATH_COUNT];
+};
+
+/*
+ * Whether to copy the call to the pseudo ports at setup. On by default: it
+ * costs nothing when nobody reads them, and it is what lets userspace record
+ * a call or bridge it to a Bluetooth headset.
+ */
+/*
+ * Off by default: arming the taps during a live call was seen to take the
+ * uplink away from the modem - the far end stopped hearing anything the
+ * moment the command went in - so this must not be on until the mechanism
+ * is understood.
+ */
+static bool incall_taps;
+module_param(incall_taps, bool, 0644);
+MODULE_PARM_DESC(incall_taps, "copy call audio to the record/playback pseudo ports");
+
+/*
+ * Trigger the record taps by hand, to test WHEN they have to be issued.
+ * The vendor stack does not arm them while setting the call up: its routing
+ * driver calls the equivalent when the capture front-end starts, which is a
+ * different moment entirely. Writing 1 here reproduces that order without
+ * wiring the whole path first.
+ */
+static int record_dirs = 1;	/* downlink only by default: the safe one */
+
+/*
+ * Vendor-faithful in-call record trigger, called from the routing driver
+ * when the mixer route to a record port is toggled. Which direction gets
+ * tapped follows from WHICH port is routed - downlink for VOICE_RECORD_RX,
+ * uplink for VOICE_RECORD_TX, both when both are - with the same flag
+ * machine the vendor stack keeps per session (voc_start_record()).
+ */
+static struct {
+	bool ul, dl;
+} q6voice_rec_state;
+
+int q6voice_incall_record_route(bool tx_port, bool set)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	struct q6voice_session *cvs;
+	int ret = 0, i;
+
+	if (!v)
+		return 0;	/* no voice driver, nothing to do */
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (!p->runtime || !p->runtime->sessions[Q6VOICE_SERVICE_CVS]) {
+			mutex_unlock(&p->lock);
+			continue;
+		}
+		cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+		if (set) {
+			if (q6voice_rec_state.ul && q6voice_rec_state.dl) {
+				mutex_unlock(&p->lock);
+				continue;	/* already recording both */
+			}
+			if (tx_port)
+				q6voice_rec_state.ul = true;
+			else
+				q6voice_rec_state.dl = true;
+			/* going from one direction to both needs a restart */
+			if (q6voice_rec_state.ul && q6voice_rec_state.dl)
+				q6cvs_stop_record(cvs);
+		} else {
+			if (!q6voice_rec_state.ul && !q6voice_rec_state.dl) {
+				mutex_unlock(&p->lock);
+				continue;	/* nothing running */
+			}
+			if (tx_port)
+				q6voice_rec_state.ul = false;
+			else
+				q6voice_rec_state.dl = false;
+			q6cvs_stop_record(cvs);
+		}
+
+		if (q6voice_rec_state.ul || q6voice_rec_state.dl)
+			ret = q6cvs_start_record(cvs, q6voice_rec_state.dl,
+						 q6voice_rec_state.ul);
+		dev_info(v->dev,
+			 "in-call record route %s %s -> taps dl=%d ul=%d: %d\n",
+			 tx_port ? "uplink" : "downlink", set ? "on" : "off",
+			 q6voice_rec_state.dl, q6voice_rec_state.ul, ret);
+		mutex_unlock(&p->lock);
+		return ret;
+	}
+
+	/* no active call: remember nothing, the route alone is harmless */
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_incall_record_route);
+
+/**
+ * q6voice_incall_playback_route() - feed the far end from a CPU stream
+ * @set: whether the injection port just got routed or unrouted
+ *
+ * The mirror image of the record taps: anything played to pseudo port 0x8005
+ * is mixed into the uplink, which is how a headset's microphone can reach the
+ * other party without the modem ever seeing the CPU.
+ */
+int q6voice_incall_playback_route(bool set)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	struct q6voice_session *cvs;
+	int ret = 0, i;
+
+	if (!v)
+		return 0;
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (!p->runtime || !p->runtime->sessions[Q6VOICE_SERVICE_CVS]) {
+			mutex_unlock(&p->lock);
+			continue;
+		}
+		cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+		ret = set ? q6cvs_start_playback(cvs) : q6cvs_stop_playback(cvs);
+		dev_info(v->dev, "in-call playback route %s: %d\n",
+			 set ? "on" : "off", ret);
+		mutex_unlock(&p->lock);
+		return ret;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6voice_incall_playback_route);
+
+/*
+ * Uplink mute, the way the vendor stack does it: VSS_IVOLUME_CMD_MUTE_V2 on
+ * the voice stream. The microphone's analogue gain at its minimum, which is
+ * what the call profile used for mute, still let the room through at about
+ * -29 dB (measured on a POCO X3 NFC with a tone played into a call). Kept
+ * across calls and applied when a call is set up.
+ */
+static bool q6voice_tx_muted;
+
+int q6voice_set_tx_mute(bool mute)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	int ret = 0, i;
+
+	q6voice_tx_muted = mute;
+	if (!v)
+		return 0;
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (p->runtime && p->runtime->started == 3 &&
+		    p->runtime->sessions[Q6VOICE_SERVICE_CVS])
+			ret = q6cvs_mute(p->runtime->sessions[Q6VOICE_SERVICE_CVS],
+					 0 /* TX */, mute);
+		mutex_unlock(&p->lock);
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_tx_mute);
+
+bool q6voice_get_tx_mute(void)
+{
+	return q6voice_tx_muted;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_tx_mute);
+
+static int q6voice_record_now_set(const char *val, const struct kernel_param *kp)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	int ret, i, want;
+
+	if (!v)
+		return -ENODEV;
+
+	if (!kstrtoint(val, 0, &want) && want > 0 && want <= 3)
+		record_dirs = want;
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (p->runtime && p->runtime->sessions[Q6VOICE_SERVICE_CVS]) {
+			/*
+			 * Which directions to tap comes from the value written:
+			 * 1 = downlink only, 2 = uplink only, 3 = both. Tapping
+			 * the uplink has been seen to take it away from the
+			 * modem, so being able to ask for just the downlink is
+			 * how that gets pinned down.
+			 */
+			bool rx = record_dirs & 1, tx = record_dirs & 2;
+
+			ret = q6cvs_start_record(p->runtime->sessions[Q6VOICE_SERVICE_CVS],
+						 rx, tx);
+			dev_info(v->dev, "record taps started by hand (rx=%d tx=%d): %d\n",
+				 rx, tx, ret);
+			mutex_unlock(&p->lock);
+			return 0;
+		}
+		mutex_unlock(&p->lock);
+	}
+
+	dev_info(v->dev, "no active voice session to record\n");
+	return -ENODEV;
+}
+
+static const struct kernel_param_ops q6voice_record_now_ops = {
+	.set = q6voice_record_now_set,
+};
+module_param_cb(record_now, &q6voice_record_now_ops, NULL, 0200);
+MODULE_PARM_DESC(record_now, "write 1 while a call is up to arm the record taps");
+module_param(record_dirs, int, 0644);
+MODULE_PARM_DESC(record_dirs, "which directions to tap: 1 downlink, 2 uplink, 3 both");
+
+/*
+ * Vendor vocproc setup, step by step (/sys/module/q6voice/parameters/vendor_steps,
+ * read when a vocproc is built). All off by default, which is what mainline did.
+ *
+ * The vendor's voice topologies (custom, registered with q6core custom_topologies;
+ * select them with q6cvp tx_topology/rx_topology and create_v3) need what the
+ * downstream voice_setup_vocproc() does between creating the vocproc and enabling
+ * it: channel info, a topology commit and the ACDB calibration. Media format goes
+ * after the attach. Each step logs what the DSP answered, and none of them stops
+ * the call. The Bluetooth headset path is left alone: its calibration was not
+ * captured and it uses the standard topologies.
+ */
+#define Q6VOICE_VENDOR_CHANNEL_INFO	BIT(0)
+#define Q6VOICE_VENDOR_TOPOLOGY_COMMIT	BIT(1)
+#define Q6VOICE_VENDOR_CALIBRATION	BIT(2)
+#define Q6VOICE_VENDOR_MEDIA_FORMAT	BIT(3)
+
+static uint vendor_steps;
+module_param(vendor_steps, uint, 0644);
+MODULE_PARM_DESC(vendor_steps,
+		 "vendor vocproc setup: 1 channel info, 2 topology commit, 4 calibration, 8 media format");
+
+/* Which calibration set: firmware qcom/sm7150/xiaomi/surya/voice-<cal_set>-*.bin */
+static char cal_set[32] = "handset";
+module_param_string(cal_set, cal_set, sizeof(cal_set), 0644);
+MODULE_PARM_DESC(cal_set, "voice calibration set (handset, speaker, handset-aec, speaker-aec)");
+
+/*
+ * The ACDB marks its tables per-vocoder (cal_hdr.version & 0x10000), and then
+ * downstream registers them with the STATIC/DYNAMIC opcodes instead of V2.
+ */
+static bool per_vocoder_cal = true;
+module_param(per_vocoder_cal, bool, 0644);
+MODULE_PARM_DESC(per_vocoder_cal, "register calibration with the per-vocoder STATIC/DYNAMIC opcodes");
+
+/* The vocproc sample rate the ACDB static tables were made for (48 kHz here) */
+static uint vendor_sample_rate = 48000;
+module_param(vendor_sample_rate, uint, 0644);
+MODULE_PARM_DESC(vendor_sample_rate, "sample rate sent with the endpoint media format");
+
+#define Q6VOICE_CAL_DIR				"qcom/sm7150/xiaomi/surya/"
+#define Q6VOICE_MAX_COL_INFO_SIZE		324
+#define Q6VOICE_PCM_CHANNEL_FC			3
+
+#define VSS_PARAM_VOCPROC_TX_CHANNEL_INFO	0x0001328E
+#define VSS_PARAM_VOCPROC_RX_CHANNEL_INFO	0x0001328F
+#define VSS_PARAM_VOCPROC_EC_REF_CHANNEL_INFO	0x00013290
+#define VSS_PARAM_TX_PORT_ENDPOINT_MEDIA_INFO	0x00013253
+#define VSS_PARAM_RX_PORT_ENDPOINT_MEDIA_INFO	0x00013254
+
+#define VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2		0x00011369
+#define VSS_ISTREAM_CMD_DEREGISTER_CALIBRATION_DATA		0x0001127A
+#define VSS_ISTREAM_CMD_REGISTER_STATIC_CALIBRATION_DATA	0x0001307D
+#define VSS_ISTREAM_CMD_DEREGISTER_STATIC_CALIBRATION_DATA	0x0001307E
+#define VSS_IVOCPROC_CMD_DEREGISTER_DEVICE_CONFIG		0x00011372
+#define VSS_IVOCPROC_CMD_REGISTER_CALIBRATION_DATA_V2		0x00011373
+#define VSS_IVOCPROC_CMD_DEREGISTER_CALIBRATION_DATA		0x00011276
+#define VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA		0x00011374
+#define VSS_IVOCPROC_CMD_DEREGISTER_VOL_CALIBRATION_DATA	0x00011375
+#define VSS_IVOCPROC_CMD_REGISTER_STATIC_CALIBRATION_DATA	0x00013079
+#define VSS_IVOCPROC_CMD_DEREGISTER_STATIC_CALIBRATION_DATA	0x0001307A
+#define VSS_IVOCPROC_CMD_REGISTER_DYNAMIC_CALIBRATION_DATA	0x0001307B
+#define VSS_IVOCPROC_CMD_DEREGISTER_DYNAMIC_CALIBRATION_DATA	0x0001307C
+
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX	0x400e
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX	0x400f
+
+enum { Q6VOICE_CAL_DEVCFG, Q6VOICE_CAL_STATIC, Q6VOICE_CAL_VOL,
+       Q6VOICE_CAL_STREAM, Q6VOICE_CAL_COUNT };
+static const char * const q6voice_cal_part[Q6VOICE_CAL_COUNT] = {
+	"devcfg", "static", "vol", "stream",
+};
+
+struct q6voice_cal_blob {
+	void *buf;
+	dma_addr_t dma;
+	size_t alloc, len;
+	u64 dsp;
+	u32 handle;
+	u8 col[Q6VOICE_MAX_COL_INFO_SIZE];
+	size_t col_len;
+};
+
+struct q6voice_cal {
+	struct device *dev;	/* the only audio node with an SMMU the DSP can reach */
+	int sid;
+	void *table;		/* vss_imemory_table_t, reused for every mapping */
+	dma_addr_t table_dma;
+	struct q6voice_cal_blob blob[Q6VOICE_CAL_COUNT];
+};
+
+static bool q6voice_path_is_bt(struct q6voice_path *p)
+{
+	return q6afe_get_port_id(p->tx_port) == AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX ||
+	       q6afe_get_port_id(p->rx_port) == AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX;
+}
+
+/*
+ * Same as q6asm-dai builds prtd->phys: the stream ID goes in the upper 32 bits.
+ * VSS_IMEMORY_CMD_MAP_PHYSICAL refused such an address (ADSP_EBADPARAM, with
+ * is_cached = 0) where it had taken a plain physical one; cal_sid=N leaves the
+ * stream ID out, to tell the two apart between calls.
+ */
+static bool cal_sid = true;
+module_param(cal_sid, bool, 0644);
+MODULE_PARM_DESC(cal_sid, "put the SMMU stream ID in the upper bits of voice calibration addresses");
+
+static u64 q6voice_dsp_addr(struct q6voice_cal *cal, dma_addr_t dma)
+{
+	return cal->sid < 0 || !cal_sid ? dma : dma | ((u64)cal->sid << 32);
+}
+
+static struct device *q6voice_find_dsp_dev(int *sid)
+{
+	struct of_phandle_args args;
+	struct platform_device *pdev;
+	struct device_node *np;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,q6asm-dais");
+	if (!np)
+		return NULL;
+
+	if (of_parse_phandle_with_fixed_args(np, "iommus", 1, 0, &args)) {
+		*sid = -1;
+	} else {
+		*sid = args.args[0] & 0xF;
+		of_node_put(args.np);
+	}
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+
+	return pdev ? &pdev->dev : NULL;
+}
+
+/* Needs the MVM session still alive: the handles belong to it. */
+static void q6voice_cal_unload(struct q6voice_path *p)
+{
+	struct q6voice_session *mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	struct q6voice_cal *cal = p->runtime->cal;
+	int i, ret;
+
+	if (!cal)
+		return;
+
+	for (i = 0; i < Q6VOICE_CAL_COUNT; i++) {
+		struct q6voice_cal_blob *b = &cal->blob[i];
+
+		if (b->handle && mvm) {
+			ret = q6mvm_unmap_memory(mvm, b->handle);
+			if (ret)
+				dev_warn(p->v->dev, "unmap voice cal %s: %d\n",
+					 q6voice_cal_part[i], ret);
+		}
+		if (b->buf)
+			dma_free_coherent(cal->dev, b->alloc, b->buf, b->dma);
+	}
+	if (cal->table)
+		dma_free_coherent(cal->dev, PAGE_SIZE, cal->table, cal->table_dma);
+	if (cal->dev)
+		put_device(cal->dev);
+
+	kfree(cal);
+	p->runtime->cal = NULL;
+	p->runtime->cvs_cal = false;
+	p->runtime->cvp_cal = false;
+}
+
+static int q6voice_cal_load(struct q6voice_path *p)
+{
+	struct q6voice_session *mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	struct device *dev = p->v->dev;
+	const struct firmware *fw;
+	struct q6voice_cal *cal;
+	/* a sysfs write keeps its trailing newline in a string parameter */
+	int set_len = strcspn(cal_set, "\n");
+	char name[96];
+	int i, ret;
+
+	if (p->runtime->cal)
+		return 0;
+	if (!mvm)
+		return -ENODEV;
+
+	cal = kzalloc(sizeof(*cal), GFP_KERNEL);
+	if (!cal)
+		return -ENOMEM;
+	p->runtime->cal = cal;
+
+	cal->dev = q6voice_find_dsp_dev(&cal->sid);
+	if (!cal->dev) {
+		ret = -ENODEV;
+		goto err;
+	}
+
+	/* page-sized: MAP_PHYSICAL refuses a table that is not page aligned */
+	cal->table = dma_alloc_coherent(cal->dev, PAGE_SIZE, &cal->table_dma,
+					GFP_KERNEL);
+	if (!cal->table) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	for (i = 0; i < Q6VOICE_CAL_COUNT; i++) {
+		struct q6voice_cal_blob *b = &cal->blob[i];
+		u32 *t = cal->table;
+
+		snprintf(name, sizeof(name), Q6VOICE_CAL_DIR "voice-%.*s-%s.bin",
+			 set_len, cal_set, q6voice_cal_part[i]);
+		ret = request_firmware(&fw, name, dev);
+		if (ret)
+			goto err;
+
+		b->len = fw->size;
+		b->alloc = PAGE_ALIGN(fw->size);
+		b->buf = dma_alloc_coherent(cal->dev, b->alloc, &b->dma, GFP_KERNEL);
+		if (!b->buf) {
+			release_firmware(fw);
+			ret = -ENOMEM;
+			goto err;
+		}
+		memcpy(b->buf, fw->data, fw->size);
+		release_firmware(fw);
+		b->dsp = q6voice_dsp_addr(cal, b->dma);
+
+		if (i != Q6VOICE_CAL_DEVCFG) {
+			snprintf(name, sizeof(name),
+				 Q6VOICE_CAL_DIR "voice-%.*s-%s-col.bin",
+				 set_len, cal_set, q6voice_cal_part[i]);
+			ret = request_firmware(&fw, name, dev);
+			if (ret)
+				goto err;
+			b->col_len = min_t(size_t, fw->size, sizeof(b->col));
+			memcpy(b->col, fw->data, b->col_len);
+			release_firmware(fw);
+		}
+
+		/* vss_imemory_table_t: no next table, one block */
+		memset(cal->table, 0, 6 * sizeof(u32));
+		t[3] = lower_32_bits(b->dsp);
+		t[4] = upper_32_bits(b->dsp);
+		t[5] = b->alloc;
+
+		ret = q6mvm_map_memory(mvm, q6voice_dsp_addr(cal, cal->table_dma),
+				       6 * sizeof(u32), &b->handle);
+		dev_info(dev, "voice cal %s-%s: %zu bytes at %#llx, handle %#x: %d\n",
+			 cal_set, q6voice_cal_part[i], b->len, b->dsp, b->handle, ret);
+		if (ret)
+			goto err;
+	}
+
+	return 0;
+
+err:
+	dev_err(dev, "voice calibration %s not loaded: %d\n", cal_set, ret);
+	q6voice_cal_unload(p);
+	return ret;
+}
+
+static void q6voice_cal_register(struct q6voice_path *p)
+{
+	struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+	struct q6voice_session *cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	struct q6voice_cal *cal = p->runtime->cal;
+	struct device *dev = p->v->dev;
+	struct q6voice_cal_blob *b;
+	int ret;
+
+	if (!cal || !cvp)
+		return;
+
+	if (cvs && !p->runtime->cvs_cal) {
+		b = &cal->blob[Q6VOICE_CAL_STREAM];
+		ret = q6cvs_register_cal(cvs, per_vocoder_cal ?
+					 VSS_ISTREAM_CMD_REGISTER_STATIC_CALIBRATION_DATA :
+					 VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2,
+					 b->handle, b->dsp, b->len, b->col, b->col_len);
+		dev_info(dev, "register stream calibration: %d\n", ret);
+		p->runtime->cvs_cal = !ret;
+	}
+
+	b = &cal->blob[Q6VOICE_CAL_DEVCFG];
+	ret = q6cvp_register_dev_cfg(cvp, b->handle, b->dsp, b->len);
+	dev_info(dev, "register vocproc device config: %d\n", ret);
+
+	b = &cal->blob[Q6VOICE_CAL_STATIC];
+	ret = q6cvp_register_cal(cvp, per_vocoder_cal ?
+				 VSS_IVOCPROC_CMD_REGISTER_STATIC_CALIBRATION_DATA :
+				 VSS_IVOCPROC_CMD_REGISTER_CALIBRATION_DATA_V2,
+				 b->handle, b->dsp, b->len, b->col, b->col_len);
+	dev_info(dev, "register vocproc static calibration: %d\n", ret);
+
+	b = &cal->blob[Q6VOICE_CAL_VOL];
+	ret = q6cvp_register_cal(cvp, per_vocoder_cal ?
+				 VSS_IVOCPROC_CMD_REGISTER_DYNAMIC_CALIBRATION_DATA :
+				 VSS_IVOCPROC_CMD_REGISTER_VOL_CALIBRATION_DATA,
+				 b->handle, b->dsp, b->len, b->col, b->col_len);
+	dev_info(dev, "register vocproc volume calibration: %d\n", ret);
+
+	p->runtime->cvp_cal = true;
+}
+
+/* In the downstream order: volume, static, device config (and the stream last) */
+static void q6voice_cal_deregister_cvp(struct q6voice_path *p,
+				       struct q6voice_session *cvp)
+{
+	if (!p->runtime->cvp_cal || !cvp)
+		return;
+
+	q6cvp_deregister(cvp, per_vocoder_cal ?
+			 VSS_IVOCPROC_CMD_DEREGISTER_DYNAMIC_CALIBRATION_DATA :
+			 VSS_IVOCPROC_CMD_DEREGISTER_VOL_CALIBRATION_DATA);
+	q6cvp_deregister(cvp, per_vocoder_cal ?
+			 VSS_IVOCPROC_CMD_DEREGISTER_STATIC_CALIBRATION_DATA :
+			 VSS_IVOCPROC_CMD_DEREGISTER_CALIBRATION_DATA);
+	q6cvp_deregister(cvp, VSS_IVOCPROC_CMD_DEREGISTER_DEVICE_CONFIG);
+	p->runtime->cvp_cal = false;
+}
+
+static void q6voice_cal_deregister(struct q6voice_path *p)
+{
+	struct q6voice_session *cvs = p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+	q6voice_cal_deregister_cvp(p, p->runtime->sessions[Q6VOICE_SERVICE_CVP]);
+
+	if (p->runtime->cvs_cal && cvs)
+		q6cvs_deregister_cal(cvs, per_vocoder_cal ?
+				     VSS_ISTREAM_CMD_DEREGISTER_STATIC_CALIBRATION_DATA :
+				     VSS_ISTREAM_CMD_DEREGISTER_CALIBRATION_DATA);
+	p->runtime->cvs_cal = false;
+}
+
+#define Q6VOICE_PCM_CHANNEL_FL			1
+#define Q6VOICE_PCM_CHANNEL_FR			2
+
+/*
+ * How many channels the vocproc is told its endpoints carry. This phone's ACDB
+ * describes its voice devices as mono (one channel, FC) and the vendor audio
+ * HAL sets the back ends to match, but this machine driver runs every
+ * non-Bluetooth back end, the TX codec DMA and tertiary MI2S ports among them,
+ * at two channels. With the mono figures the DSP fails the commit of the
+ * SMECNS V2 topologies; these let two channels (FL, FR) be tried between calls.
+ */
+static uint vendor_rx_channels = 1;
+module_param(vendor_rx_channels, uint, 0644);
+MODULE_PARM_DESC(vendor_rx_channels,
+		 "channels announced for the vocproc Rx endpoint and echo reference (1 or 2)");
+
+static uint vendor_tx_channels = 1;
+module_param(vendor_tx_channels, uint, 0644);
+MODULE_PARM_DESC(vendor_tx_channels, "channels announced for the vocproc Tx endpoint (1 or 2)");
+
+static u32 q6voice_vendor_map(uint channels, u8 *map)
+{
+	if (channels >= 2) {
+		map[0] = Q6VOICE_PCM_CHANNEL_FL;
+		map[1] = Q6VOICE_PCM_CHANNEL_FR;
+		return 2;
+	}
+	map[0] = Q6VOICE_PCM_CHANNEL_FC;
+	return 1;
+}
+
+/*
+ * Between creating a vocproc and enabling it, in voice_setup_vocproc()'s order:
+ * channel info, then the endpoint media format (CVD 2.3, voice_send_cvp_media_fmt_info_cmd()),
+ * then the topology commit, then the calibration. With the media format sent after the attach
+ * instead, the DSP failed the commit of the vendor's Tx topology (ADSP_EFAILED).
+ */
+static void q6voice_vendor_setup(struct q6voice_path *p, struct q6voice_session *cvp)
+{
+	struct device *dev = p->v->dev;
+	u8 rx_map[2], tx_map[2];
+	u32 rx_ch, tx_ch;
+	int ret;
+
+	if (!vendor_steps || q6voice_path_is_bt(p))
+		return;
+
+	rx_ch = q6voice_vendor_map(vendor_rx_channels, rx_map);
+	tx_ch = q6voice_vendor_map(vendor_tx_channels, tx_map);
+
+	if (vendor_steps & Q6VOICE_VENDOR_CHANNEL_INFO) {
+		ret = q6cvp_set_channel_info(cvp, VSS_PARAM_VOCPROC_RX_CHANNEL_INFO,
+					     rx_ch, 16, rx_map);
+		dev_info(dev, "vocproc rx channel info (%u ch): %d\n", rx_ch, ret);
+		ret = q6cvp_set_channel_info(cvp, VSS_PARAM_VOCPROC_TX_CHANNEL_INFO,
+					     tx_ch, 16, tx_map);
+		dev_info(dev, "vocproc tx channel info (%u ch): %d\n", tx_ch, ret);
+		ret = q6cvp_set_channel_info(cvp, VSS_PARAM_VOCPROC_EC_REF_CHANNEL_INFO,
+					     rx_ch, 16, rx_map);
+		dev_info(dev, "vocproc ec ref channel info (%u ch): %d\n", rx_ch, ret);
+	}
+
+	if (vendor_steps & Q6VOICE_VENDOR_MEDIA_FORMAT) {
+		ret = q6cvp_set_endpoint_media_format(cvp, VSS_PARAM_RX_PORT_ENDPOINT_MEDIA_INFO,
+						      q6afe_get_port_id(p->rx_port), rx_ch, 16,
+						      vendor_sample_rate, rx_map);
+		dev_info(dev, "vocproc rx endpoint media format: %d\n", ret);
+		ret = q6cvp_set_endpoint_media_format(cvp, VSS_PARAM_TX_PORT_ENDPOINT_MEDIA_INFO,
+						      q6afe_get_port_id(p->tx_port), tx_ch, 16,
+						      vendor_sample_rate, tx_map);
+		dev_info(dev, "vocproc tx endpoint media format: %d\n", ret);
+	}
+
+	if (vendor_steps & Q6VOICE_VENDOR_TOPOLOGY_COMMIT) {
+		ret = q6cvp_topology_commit(cvp);
+		dev_info(dev, "vocproc topology commit: %d\n", ret);
+	}
+
+	if (vendor_steps & Q6VOICE_VENDOR_CALIBRATION) {
+		if (!q6voice_cal_load(p))
+			q6voice_cal_register(p);
+	}
+}
+
+static int q6voice_path_start(struct q6voice_path *p)
+{
+	struct device *dev = p->v->dev;
+	struct q6voice_session *mvm, *cvp;
+	int ret;
+
+	dev_dbg(dev, "start path %d\n", p->type);
+
+	mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	if (!mvm) {
+		mvm = q6mvm_session_create(p->type);
+		if (IS_ERR(mvm))
+			return PTR_ERR(mvm);
+		p->runtime->sessions[Q6VOICE_SERVICE_MVM] = mvm;
+	}
+
+	/*
+	 * The downstream driver creates a matching passive CVS session (same
+	 * name as the MVM) for CS calls too, but never attaches it with
+	 * ATTACH_STREAM: that command only appears on its VoIP path. For a CS
+	 * call the DSP must be pairing the AP's passive MVM/CVS with the
+	 * modem's own full-control session by session name, not by an
+	 * explicit attach from here.
+	 */
+	if (!p->runtime->sessions[Q6VOICE_SERVICE_CVS]) {
+		struct q6voice_session *cvs = q6cvs_session_create(p->type);
+
+		if (IS_ERR(cvs))
+			return PTR_ERR(cvs);
+		p->runtime->sessions[Q6VOICE_SERVICE_CVS] = cvs;
+	}
+
+	cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	if (!cvp) {
+		dev_info(dev, "creating cvp: tx_port=%d (afe %d) rx_port=%d (afe %d)\n",
+			 p->tx_port, q6afe_get_port_id(p->tx_port),
+			 p->rx_port, q6afe_get_port_id(p->rx_port));
+		cvp = q6cvp_session_create(p->type,
+					   q6afe_get_port_id(p->tx_port),
+					   q6afe_get_port_id(p->rx_port));
+		if (IS_ERR(cvp))
+			return PTR_ERR(cvp);
+		p->runtime->sessions[Q6VOICE_SERVICE_CVP] = cvp;
+		p->runtime->cvp_tx_port = p->tx_port;
+		p->runtime->cvp_rx_port = p->rx_port;
+
+		q6voice_vendor_setup(p, cvp);
+	}
+
+	ret = q6cvp_enable(cvp, true);
+	if (ret) {
+		dev_err(dev, "failed to enable cvp: %d\n", ret);
+		goto cvp_err;
+	}
+
+	ret = q6mvm_attach(mvm, cvp, true);
+	if (ret) {
+		dev_err(dev, "failed to attach cvp to mvm: %d\n", ret);
+		goto attach_err;
+	}
+
+	/*
+	 * Mirrors the downstream's voice_send_vol_step_cmd() /
+	 * voice_send_stream_mute_cmd() between vocproc attach and MVM start.
+	 * Both are best-effort like downstream: it logs and carries on if
+	 * either fails, it does not abort the call. The volume step needs an
+	 * ACDB calibration table to resolve against, which nothing here
+	 * loads, so on an uncalibrated profile it is expected to fail; the
+	 * unmute does not depend on calibration and is expected to succeed.
+	 */
+	ret = q6cvp_set_rx_volume(cvp, rx_volume_step);
+	if (ret)
+		dev_dbg(dev, "rx volume step %d not applied: %d\n", rx_volume_step, ret);
+
+	ret = q6cvs_mute(p->runtime->sessions[Q6VOICE_SERVICE_CVS], 0 /* TX */,
+			 q6voice_tx_muted);
+	if (ret)
+		dev_dbg(dev, "tx %smute not applied: %d\n",
+			q6voice_tx_muted ? "" : "un", ret);
+
+	ret = q6mvm_start(mvm, true);
+	if (ret) {
+		dev_err(dev, "failed to start voice: %d\n", ret);
+		goto start_err;
+	}
+
+	/*
+	 * Make the conversation reachable from the CPU. Without this the call
+	 * exists only between the modem and the DSP, so nothing can record it
+	 * or carry it anywhere else - a Bluetooth headset included, since the
+	 * headset's own link is driven by the CPU.
+	 *
+	 * Best effort on purpose: a DSP that refuses the taps must not stop a
+	 * call that is otherwise working.
+	 */
+	if (incall_taps) {
+		struct q6voice_session *cvs =
+			p->runtime->sessions[Q6VOICE_SERVICE_CVS];
+
+		/*
+		 * Playback before recording, the order the vendor driver uses
+		 * when it brings these up as part of starting a call.
+		 */
+		ret = q6cvs_start_playback(cvs);
+		if (ret)
+			dev_dbg(dev, "in-call playback not started: %d\n", ret);
+
+		/*
+		 * Which directions to tap comes from record_dirs (1 = the far
+		 * end, 2 = the microphone, 3 = both). Tapping the microphone
+		 * takes it away from the modem instead of copying it, so the
+		 * default is the far end alone.
+		 */
+		if (record_dirs)
+			ret = q6cvs_start_record(cvs, record_dirs & 1,
+						 record_dirs & 2);
+		if (ret)
+			dev_dbg(dev, "in-call record taps not started: %d\n", ret);
+		ret = 0;
+	}
+
+	return ret;
+
+start_err:
+	q6mvm_start(mvm, false);
+attach_err:
+	q6mvm_attach(mvm, cvp, false);
+cvp_err:
+	q6cvp_enable(cvp, false);
+	return ret;
+}
+
+int q6voice_start(struct q6voice *v, enum q6voice_path_type path, bool capture)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime) {
+		p->runtime = kzalloc(sizeof(*p), GFP_KERNEL);
+		if (!p->runtime) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+
+	if (p->runtime->started & BIT(capture)) {
+		ret = -EALREADY;
+		goto out;
+	}
+
+	p->runtime->started |= BIT(capture);
+
+	/* FIXME: For now we only start if both RX/TX are active */
+	if (p->runtime->started != 3)
+		goto out;
+
+	ret = q6voice_path_start(p);
+	if (ret) {
+		p->runtime->started &= ~BIT(capture);
+		dev_err(v->dev, "failed to start path %d: %d\n", path, ret);
+		goto out;
+	}
+
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_start);
+
+static void q6voice_path_stop(struct q6voice_path *p)
+{
+	struct device *dev = p->v->dev;
+	struct q6voice_session *mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	struct q6voice_session *cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	int ret;
+
+	dev_dbg(dev, "stop path %d\n", p->type);
+
+	/*
+	 * Either session can be missing here: a device move whose rebuild
+	 * failed - the DSP had just crashed underneath it - leaves the path
+	 * without a vocproc, and the call is still torn down later, when
+	 * userspace closes the PCM. q6mvm_attach() dereferencing that NULL
+	 * vocproc was a kernel oops, and with the panic after it a hung phone.
+	 */
+	if (mvm) {
+		ret = q6mvm_start(mvm, false);
+		if (ret)
+			dev_err(dev, "failed to stop voice: %d\n", ret);
+	}
+
+	if (mvm && cvp) {
+		ret = q6mvm_attach(mvm, cvp, false);
+		if (ret)
+			dev_err(dev, "failed to detach cvp from mvm: %d\n", ret);
+	}
+
+	if (cvp) {
+		ret = q6cvp_enable(cvp, false);
+		if (ret)
+			dev_err(dev, "failed to disable cvp: %d\n", ret);
+	}
+
+	q6voice_cal_deregister(p);
+}
+
+static void q6voice_path_destroy(struct q6voice_path *p)
+{
+	struct q6voice_path_runtime *runtime = p->runtime;
+	enum q6voice_service_type svc;
+
+	/*
+	 * Not _sync: this runs under p->lock and the work takes it too.
+	 * Clearing the runtime below is what makes a work that already
+	 * started do nothing.
+	 */
+	cancel_delayed_work(&p->switch_work);
+
+	/* before the sessions go: the calibration handles belong to the MVM */
+	q6voice_cal_unload(p);
+
+	for (svc = 0; svc < Q6VOICE_SERVICE_COUNT; ++svc) {
+		if (runtime->sessions[svc])
+			q6voice_session_release(runtime->sessions[svc]);
+	}
+
+	p->runtime = NULL;
+	kfree(runtime);
+}
+
+int q6voice_stop(struct q6voice *v, enum q6voice_path_type path, bool capture)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret = 0;
+
+	mutex_lock(&p->lock);
+	if (!p->runtime || !(p->runtime->started & BIT(capture)))
+		goto out;
+
+	if (p->runtime->started == 3)
+		q6voice_path_stop(p);
+
+	p->runtime->started &= ~BIT(capture);
+
+	if (p->runtime->started == 0)
+		q6voice_path_destroy(p);
+
+out:
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_stop);
+
+static void q6voice_free(void *data)
+{
+	struct q6voice *v = data;
+	enum q6voice_path_type path;
+
+	if (q6voice_live == v)
+		q6voice_live = NULL;
+
+	for (path = 0; path < Q6VOICE_PATH_COUNT; ++path) {
+		struct q6voice_path *p = &v->paths[path];
+
+		mutex_lock(&p->lock);
+		if (p->runtime) {
+			dev_warn(v->dev,
+				 "q6voice_remove() called while path %d is active\n",
+				 path);
+
+			if (p->runtime->started == 3)
+				q6voice_path_stop(p);
+			q6voice_path_destroy(p);
+		}
+		mutex_unlock(&p->lock);
+		mutex_destroy(&p->lock);
+	}
+}
+
+struct q6voice *q6voice_create(struct device *dev)
+{
+	struct q6voice *v;
+	enum q6voice_path_type path;
+	int ret;
+
+	v = devm_kzalloc(dev, sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return ERR_PTR(-ENOMEM);
+
+	v->dev = dev;
+
+	for (path = 0; path < Q6VOICE_PATH_COUNT; ++path) {
+		struct q6voice_path *p = &v->paths[path];
+
+		p->v = v;
+		p->type = path;
+		mutex_init(&p->lock);
+		INIT_DELAYED_WORK(&p->switch_work, q6voice_switch_device);
+	}
+
+	ret = devm_add_action(dev, q6voice_free, v);
+	if (ret)
+		return ERR_PTR(ret);
+
+	q6voice_live = v;
+
+	return v;
+}
+EXPORT_SYMBOL_GPL(q6voice_create);
+
+int q6voice_get_port(struct q6voice *v, enum q6voice_path_type path,
+		     bool capture)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	if (capture)
+		return p->tx_port;
+	else
+		return p->rx_port;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_port);
+
+/*
+ * Move a call that is already running to another device.
+ *
+ * The vocproc is built once, at the start of the call, with whatever ports
+ * were routed at that instant, and it was never rebuilt afterwards: routing
+ * the call elsewhere mid-call changed the mixer and powered up the new
+ * back-end, but the conversation kept flowing to the old one. That is what
+ * made moving a call to a Bluetooth headset a race - it only worked if the
+ * routing happened to be in place before the modem reported the call, and
+ * userspace has no way to guarantee that: wireplumber picks the voice-call
+ * profile *after* the session has started.
+ *
+ * Two ways to move it, chosen by switch_full_session:
+ *  - vocproc only, what the vendor driver does: pause the call, throw the
+ *    vocproc away, build a new one against the new ports, and start again.
+ *    The MVM and CVS sessions survive untouched.
+ *  - new voice session: tear the AP side of the call down exactly as its end
+ *    does, and build it again exactly as its start does. The modem keeps its
+ *    own full-control session through this, and the AP's passive one pairs
+ *    with it again by name (see q6voice-common.c).
+ * Either way the call itself is never torn down - the far end hears a short
+ * gap, nothing more.
+ */
+static void q6voice_drop_session(struct q6voice_path *p,
+				 enum q6voice_service_type svc)
+{
+	struct q6voice_session *s = p->runtime->sessions[svc];
+
+	if (s) {
+		q6voice_session_release(s);
+		p->runtime->sessions[svc] = NULL;
+	}
+}
+
+static void q6voice_switch_device(struct work_struct *work)
+{
+	struct q6voice_path *p = container_of(to_delayed_work(work),
+					      struct q6voice_path, switch_work);
+	struct device *dev = p->v->dev;
+	struct q6voice_session *mvm, *cvp;
+	bool force, full, cal_only;
+	int ret;
+
+	mutex_lock(&p->lock);
+
+	if (!p->runtime || p->runtime->started != 3)
+		goto out;
+
+	force = p->runtime->rekick;
+	p->runtime->rekick = false;
+	/* The unprompted repeat (see below) stays a vocproc-only rebuild. */
+	full = switch_full_session && !force;
+
+	cvp = p->runtime->sessions[Q6VOICE_SERVICE_CVP];
+	mvm = p->runtime->sessions[Q6VOICE_SERVICE_MVM];
+	/*
+	 * A vocproc-only move needs both sessions. A full one does not, and it
+	 * is also what brings back a call whose previous rebuild failed half way.
+	 */
+	if (!full && (!cvp || !mvm))
+		goto out;
+
+	/* Both ends have to be somewhere real, and somewhere else. */
+	if (!p->tx_port || !p->rx_port)
+		goto out;
+	cal_only = cvp && p->tx_port == p->runtime->cvp_tx_port &&
+		   p->rx_port == p->runtime->cvp_rx_port && !force;
+	if (cal_only && !p->runtime->cal_change)
+		goto out;
+
+	dev_info(dev, "moving call: tx_port %d -> %d, rx_port %d -> %d (%s%s)\n",
+		 p->runtime->cvp_tx_port, p->tx_port,
+		 p->runtime->cvp_rx_port, p->rx_port,
+		 full ? "new voice session" : "vocproc only",
+		 p->runtime->cal_change ? ", new calibration" : "");
+
+	if (full) {
+		q6voice_path_stop(p);
+		q6voice_cal_unload(p);
+		p->runtime->cal_change = false;
+		q6voice_drop_session(p, Q6VOICE_SERVICE_CVP);
+		q6voice_drop_session(p, Q6VOICE_SERVICE_CVS);
+		q6voice_drop_session(p, Q6VOICE_SERVICE_MVM);
+
+		ret = q6voice_path_start(p);
+		if (ret) {
+			dev_err(dev, "failed to rebuild the voice session: %d\n", ret);
+			goto out;
+		}
+		goto rekick;
+	}
+
+	ret = q6mvm_start(mvm, false);
+	if (ret)
+		dev_err(dev, "failed to pause voice for the switch: %d\n", ret);
+	ret = q6mvm_attach(mvm, cvp, false);
+	if (ret)
+		dev_err(dev, "failed to detach the old cvp: %d\n", ret);
+	ret = q6cvp_enable(cvp, false);
+	if (ret)
+		dev_err(dev, "failed to disable the old cvp: %d\n", ret);
+
+	if (p->runtime->cal_change)
+		q6voice_cal_deregister(p);
+	else
+		q6voice_cal_deregister_cvp(p, cvp);
+	q6voice_session_release(cvp);
+	p->runtime->sessions[Q6VOICE_SERVICE_CVP] = NULL;
+	if (p->runtime->cal_change) {
+		/* vendor_setup below loads and registers the new set */
+		q6voice_cal_unload(p);
+		p->runtime->cal_change = false;
+	}
+
+	cvp = q6cvp_session_create(p->type, q6afe_get_port_id(p->tx_port),
+				   q6afe_get_port_id(p->rx_port));
+	if (IS_ERR(cvp)) {
+		dev_err(dev, "failed to rebuild the cvp: %ld\n", PTR_ERR(cvp));
+		goto out;
+	}
+	p->runtime->sessions[Q6VOICE_SERVICE_CVP] = cvp;
+	p->runtime->cvp_tx_port = p->tx_port;
+	p->runtime->cvp_rx_port = p->rx_port;
+
+	q6voice_vendor_setup(p, cvp);
+
+	ret = q6cvp_enable(cvp, true);
+	if (ret) {
+		dev_err(dev, "failed to enable the new cvp: %d\n", ret);
+		goto out;
+	}
+	ret = q6mvm_attach(mvm, cvp, true);
+	if (ret) {
+		dev_err(dev, "failed to attach the new cvp: %d\n", ret);
+		goto out;
+	}
+
+	/* Best effort, same as when the call was set up. */
+	ret = q6cvp_set_rx_volume(cvp, rx_volume_step);
+	if (ret)
+		dev_dbg(dev, "rx volume step not reapplied: %d\n", ret);
+
+	ret = q6mvm_start(mvm, true);
+	if (ret)
+		dev_err(dev, "failed to resume voice after the switch: %d\n", ret);
+
+rekick:
+	/* A new calibration on the same ports needs no second attempt. */
+	if (cal_only)
+		goto out;
+	/*
+	 * Rekick: repeat this rebuild once, unprompted.
+	 *
+	 * Moving the call onto the Bluetooth ports right after a routing
+	 * change loses a race about half the time - the chip's bus ports and
+	 * the SCO holder are still settling when the vocproc lands, and the
+	 * call stays silent even though every step reported success. Pressing
+	 * the output button again always fixed it, because by the second
+	 * attempt everything has settled. This schedules that second attempt
+	 * automatically: same rebuild, same ports, ~0.8 s later. The far end
+	 * hears a short gap; a gap beats silence.
+	 */
+	if (!force) {
+		p->runtime->rekick = true;
+		mod_delayed_work(system_wq, &p->switch_work,
+				 msecs_to_jiffies(800));
+	}
+
+out:
+	mutex_unlock(&p->lock);
+}
+
+void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
+		      bool capture, int index)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	if (capture)
+		p->tx_port = index;
+	else
+		p->rx_port = index;
+
+	/*
+	 * Coalesce: moving a call touches four mixer controls (old device off,
+	 * new device on, for each direction) and there is a moment in the
+	 * middle where one end reads as nowhere. Waiting a little lets the
+	 * whole sequence land before the vocproc is rebuilt once.
+	 */
+	if (p->runtime && p->runtime->started == 3)
+		mod_delayed_work(system_wq, &p->switch_work,
+				 msecs_to_jiffies(200));
+}
+EXPORT_SYMBOL_GPL(q6voice_set_port);
+
+static bool q6voice_cal_set_is(const char *set)
+{
+	size_t len = strcspn(cal_set, "\n");
+
+	return strlen(set) == len && !strncmp(cal_set, set, len);
+}
+
+const char *q6voice_get_cal_set(void)
+{
+	return cal_set;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_cal_set);
+
+/*
+ * Choose the calibration set, as downstream does when a call moves between
+ * the earpiece and the loudspeaker: each has its own ACDB tables, including
+ * the Rx volume ones, so the speakerphone keeps the earpiece's level with the
+ * earpiece's set. Both share the same AFE ports here, so moving the call does
+ * not rebuild the vocproc; a change during a call rebuilds it with the new set.
+ * Returns 1 if the set changed.
+ */
+int q6voice_set_cal_set(const char *set)
+{
+	struct q6voice *v = q6voice_live;
+	struct q6voice_path *p;
+	int i;
+
+	if (q6voice_cal_set_is(set))
+		return 0;
+
+	strscpy(cal_set, set, sizeof(cal_set));
+	if (!v)
+		return 1;
+
+	for (i = 0; i < Q6VOICE_PATH_COUNT; i++) {
+		p = &v->paths[i];
+		mutex_lock(&p->lock);
+		if (p->runtime && p->runtime->started == 3 && p->runtime->cal) {
+			p->runtime->cal_change = true;
+			mod_delayed_work(system_wq, &p->switch_work,
+					 msecs_to_jiffies(200));
+		}
+		mutex_unlock(&p->lock);
+	}
+
+	return 1;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_cal_set);
+
+MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
+MODULE_DESCRIPTION("Q6Voice driver");
+MODULE_LICENSE("GPL v2");
