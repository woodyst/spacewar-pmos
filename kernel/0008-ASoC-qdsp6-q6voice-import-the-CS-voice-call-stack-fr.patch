diff --git a/sound/soc/qcom/qdsp6/q6cvp.c b/sound/soc/qcom/qdsp6/q6cvp.c
new file mode 100644
index 000000000..8a4b70357
--- /dev/null
+++ b/sound/soc/qcom/qdsp6/q6cvp.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (c) 2012-2017, The Linux Foundation. All rights reserved.
+// Copyright (c) 2020, Stephan Gerhold
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/soc/qcom/apr.h>
+#include "q6cvp.h"
+#include "q6voice-common.h"
+
+#define VSS_IVOCPROC_DIRECTION_RX	0
+#define VSS_IVOCPROC_DIRECTION_TX	1
+#define VSS_IVOCPROC_DIRECTION_RX_TX	2
+
+#define VSS_IVOCPROC_PORT_ID_NONE	0xFFFF
+
+#define VSS_IVOCPROC_TOPOLOGY_ID_NONE			0x00010F70
+#define VSS_IVOCPROC_TOPOLOGY_ID_TX_SM_ECNS		0x00010F71
+#define VSS_IVOCPROC_TOPOLOGY_ID_TX_DM_FLUENCE		0x00010F72
+
+#define VSS_IVOCPROC_TOPOLOGY_ID_RX_DEFAULT		0x00010F77
+
+#define VSS_IVOCPROC_VOCPROC_MODE_EC_INT_MIXING		0x00010F7C
+#define VSS_IVOCPROC_VOCPROC_MODE_EC_EXT_MIXING		0x00010F7D
+
+#define VSS_ICOMMON_CAL_NETWORK_ID_NONE			0x0001135E
+
+#define VSS_IVOCPROC_CMD_ENABLE				0x000100C6
+#define VSS_IVOCPROC_CMD_DISABLE			0x000110E1
+
+#define VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V2	0x000112BF
+/* same payload as V2; what downstream sends from CVD 2.2 on */
+#define VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V3	0x00013169
+
+#define VSS_ICOMMON_CMD_SET_PARAM_V2		0x0001133D
+#define VSS_ICOMMON_CMD_SET_PARAM_V3		0x00013245
+#define VSS_IVOCPROC_CMD_TOPOLOGY_COMMIT	0x00013198
+#define VSS_IVOCPROC_CMD_REGISTER_DEVICE_CONFIG	0x00011371
+#define VSS_MODULE_CVD_GENERIC			0x0001316E
+#define Q6CVP_NUM_CHANNELS_MAX			32
+#define Q6CVP_MAX_COL_INFO_SIZE			324
+
+/* The Bluetooth headset path always uses the standard topologies */
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX	0x400e
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX	0x400f
+
+#define VSS_IVOLUME_CMD_SET_STEP		0x000112C2
+#define VSS_IVOLUME_DIRECTION_RX		1
+
+struct vss_ivolume_cmd_set_step_t {
+	u16 direction;
+	u32 value;
+	u16 ramp_duration_ms;
+} __packed;
+
+struct cvp_set_rx_volume_step_cmd {
+	struct apr_hdr hdr;
+	struct vss_ivolume_cmd_set_step_t vol_step;
+} __packed;
+
+struct vss_ivocproc_cmd_create_full_control_session_v2_cmd {
+	struct apr_hdr hdr;
+
+	/*
+	 * Vocproc direction. The supported values:
+	 * VSS_IVOCPROC_DIRECTION_RX
+	 * VSS_IVOCPROC_DIRECTION_TX
+	 * VSS_IVOCPROC_DIRECTION_RX_TX
+	 */
+	u16 direction;
+
+	/*
+	 * Tx device port ID to which the vocproc connects. If a port ID is
+	 * not being supplied, set this to #VSS_IVOCPROC_PORT_ID_NONE.
+	 */
+	u16 tx_port_id;
+
+	/*
+	 * Tx path topology ID. If a topology ID is not being supplied, set
+	 * this to #VSS_IVOCPROC_TOPOLOGY_ID_NONE.
+	 */
+	u32 tx_topology_id;
+
+	/*
+	 * Rx device port ID to which the vocproc connects. If a port ID is
+	 * not being supplied, set this to #VSS_IVOCPROC_PORT_ID_NONE.
+	 */
+	u16 rx_port_id;
+
+	/*
+	 * Rx path topology ID. If a topology ID is not being supplied, set
+	 * this to #VSS_IVOCPROC_TOPOLOGY_ID_NONE.
+	 */
+	u32 rx_topology_id;
+
+	/* Voice calibration profile ID. */
+	u32 profile_id;
+
+	/*
+	 * Vocproc mode. The supported values:
+	 * VSS_IVOCPROC_VOCPROC_MODE_EC_INT_MIXING
+	 * VSS_IVOCPROC_VOCPROC_MODE_EC_EXT_MIXING
+	 */
+	u32 vocproc_mode;
+
+	/*
+	 * Port ID to which the vocproc connects for receiving echo
+	 * cancellation reference signal. If a port ID is not being supplied,
+	 * set this to #VSS_IVOCPROC_PORT_ID_NONE. This parameter value is
+	 * ignored when the vocproc_mode parameter is set to
+	 * VSS_IVOCPROC_VOCPROC_MODE_EC_INT_MIXING.
+	 */
+	u16 ec_ref_port_id;
+
+	/*
+	 * Session name string used to identify a session that can be shared
+	 * with passive controllers (optional).
+	 */
+	char name[20];
+} __packed;
+
+/*
+ * Vocproc topologies, runtime-tunable for A/B testing between calls
+ * (/sys/module/q6cvp/parameters/{tx,rx}_topology, read at session create,
+ * i.e. at call setup).
+ *
+ * Tx defaults to VSS_IVOCPROC_TOPOLOGY_ID_NONE (passthrough), NOT the
+ * vendor's TX_SM_ECNS: the echo-canceller running WITHOUT its ACDB
+ * calibration outputs pure silence, while the sidetone (tapped before Tx
+ * processing) stays audible locally - a perfectly ACKed call whose uplink
+ * is dead. Verified on a real call: with ECNS the far end hears nothing,
+ * with NONE the mic reaches it fine. The earlier "topology makes no
+ * difference" conclusion predated the CVD session-name fix, when every
+ * call was silent for that unrelated reason - it was invalid. Switch Tx
+ * back to 0x10F71 only once real vocproc calibration loading works.
+ */
+static uint tx_topology = VSS_IVOCPROC_TOPOLOGY_ID_NONE;
+module_param(tx_topology, uint, 0644);
+MODULE_PARM_DESC(tx_topology, "Vocproc Tx topology ID (0x10F70=none/passthrough)");
+
+static uint rx_topology = VSS_IVOCPROC_TOPOLOGY_ID_RX_DEFAULT;
+module_param(rx_topology, uint, 0644);
+MODULE_PARM_DESC(rx_topology, "Vocproc Rx topology ID (0x10F70=none/passthrough)");
+
+/*
+ * The vendor's own topologies (registered through q6core custom_topologies)
+ * are refused by CREATE_FULL_CONTROL_SESSION_V2 with a plain ADSP_EFAILED;
+ * downstream creates with V3 and then sends channel info and a topology
+ * commit (q6voice vendor_steps). Off by default.
+ */
+static bool create_v3;
+module_param(create_v3, bool, 0644);
+MODULE_PARM_DESC(create_v3, "create the vocproc with CREATE_FULL_CONTROL_SESSION_V3");
+
+struct q6voice_session *q6cvp_session_create(enum q6voice_path_type path,
+					     u16 tx_port, u16 rx_port)
+{
+	struct vss_ivocproc_cmd_create_full_control_session_v2_cmd cmd;
+	bool bt = tx_port == AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX ||
+		  rx_port == AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX;
+	u32 tx = bt ? VSS_IVOCPROC_TOPOLOGY_ID_NONE : tx_topology;
+	u32 rx = bt ? VSS_IVOCPROC_TOPOLOGY_ID_RX_DEFAULT : rx_topology;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = create_v3 && !bt ?
+			 VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V3 :
+			 VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V2;
+
+	cmd.tx_topology_id = tx;
+	cmd.rx_topology_id = rx;
+
+	cmd.direction = VSS_IVOCPROC_DIRECTION_RX_TX;
+	cmd.tx_port_id = tx_port;
+	cmd.rx_port_id = rx_port;
+	cmd.profile_id = VSS_ICOMMON_CAL_NETWORK_ID_NONE;
+	cmd.vocproc_mode = VSS_IVOCPROC_VOCPROC_MODE_EC_INT_MIXING;
+	cmd.ec_ref_port_id = VSS_IVOCPROC_PORT_ID_NONE;
+
+	{
+		struct q6voice_session *s;
+
+		s = q6voice_session_create(Q6VOICE_SERVICE_CVP, path, &cmd.hdr);
+		if (!IS_ERR(s))
+			dev_info(s->dev, "vocproc topologies tx=0x%x rx=0x%x (%s)\n",
+				 tx, rx, cmd.hdr.opcode ==
+				 VSS_IVOCPROC_CMD_CREATE_FULL_CONTROL_SESSION_V3 ?
+				 "v3" : "v2");
+		return s;
+	}
+}
+EXPORT_SYMBOL_GPL(q6cvp_session_create);
+
+int q6cvp_enable(struct q6voice_session *cvp, bool state)
+{
+	struct apr_pkt cmd;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = state ? VSS_IVOCPROC_CMD_ENABLE : VSS_IVOCPROC_CMD_DISABLE;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_enable);
+
+/* VSS_PARAM_VOCPROC_{RX,TX,EC_REF}_CHANNEL_INFO, sent in-band with SET_PARAM_V2 */
+struct cvp_set_channel_info_cmd {
+	struct apr_hdr hdr;
+	u32 mem_handle;
+	u64 mem_address;
+	u32 mem_size;
+	u32 module_id;
+	u32 param_id;
+	u16 param_size;
+	u16 reserved;
+	u32 num_channels;
+	u32 bits_per_sample;
+	u8 channel_mapping[Q6CVP_NUM_CHANNELS_MAX];
+} __packed;
+
+int q6cvp_set_channel_info(struct q6voice_session *cvp, u32 param_id,
+			   u32 num_channels, u32 bits_per_sample, const u8 *map)
+{
+	struct cvp_set_channel_info_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_ICOMMON_CMD_SET_PARAM_V2;
+	cmd.mem_size = sizeof(cmd) - offsetof(struct cvp_set_channel_info_cmd,
+					      module_id);
+	cmd.module_id = VSS_MODULE_CVD_GENERIC;
+	cmd.param_id = param_id;
+	cmd.param_size = sizeof(cmd) - offsetof(struct cvp_set_channel_info_cmd,
+						num_channels);
+	cmd.num_channels = num_channels;
+	cmd.bits_per_sample = bits_per_sample;
+	memcpy(cmd.channel_mapping, map,
+	       min_t(u32, num_channels, Q6CVP_NUM_CHANNELS_MAX));
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_set_channel_info);
+
+int q6cvp_topology_commit(struct q6voice_session *cvp)
+{
+	struct apr_pkt cmd;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = VSS_IVOCPROC_CMD_TOPOLOGY_COMMIT;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_topology_commit);
+
+/* VSS_PARAM_{RX,TX}_PORT_ENDPOINT_MEDIA_INFO, in-band with SET_PARAM_V3 */
+struct cvp_set_media_format_cmd {
+	struct apr_hdr hdr;
+	u32 mem_handle;
+	u64 mem_address;
+	u32 payload_size;
+	u32 module_id;
+	u16 instance_id;
+	u16 reserved;
+	u32 param_id;
+	u32 param_size;
+	u32 port_id;
+	u16 num_channels;
+	u16 bits_per_sample;
+	u32 sample_rate;
+	u8 channel_mapping[Q6CVP_NUM_CHANNELS_MAX];
+} __packed;
+
+int q6cvp_set_endpoint_media_format(struct q6voice_session *cvp, u32 param_id,
+				    u32 port_id, u16 num_channels,
+				    u16 bits_per_sample, u32 sample_rate,
+				    const u8 *map)
+{
+	struct cvp_set_media_format_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_ICOMMON_CMD_SET_PARAM_V3;
+	cmd.payload_size = sizeof(cmd) - offsetof(struct cvp_set_media_format_cmd,
+						  module_id);
+	cmd.module_id = VSS_MODULE_CVD_GENERIC;
+	cmd.param_id = param_id;
+	cmd.param_size = sizeof(cmd) - offsetof(struct cvp_set_media_format_cmd,
+						port_id);
+	cmd.port_id = port_id;
+	cmd.num_channels = num_channels;
+	cmd.bits_per_sample = bits_per_sample;
+	cmd.sample_rate = sample_rate;
+	memcpy(cmd.channel_mapping, map,
+	       min_t(u32, num_channels, Q6CVP_NUM_CHANNELS_MAX));
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_set_endpoint_media_format);
+
+struct cvp_register_dev_cfg_cmd {
+	struct apr_hdr hdr;
+	u32 mem_handle;
+	u32 mem_address_lsw;
+	u32 mem_address_msw;
+	u32 mem_size;
+} __packed;
+
+int q6cvp_register_dev_cfg(struct q6voice_session *cvp, u32 mem_handle,
+			   u64 addr, u32 size)
+{
+	struct cvp_register_dev_cfg_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOCPROC_CMD_REGISTER_DEVICE_CONFIG;
+	cmd.mem_handle = mem_handle;
+	cmd.mem_address_lsw = lower_32_bits(addr);
+	cmd.mem_address_msw = upper_32_bits(addr);
+	cmd.mem_size = size;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_register_dev_cfg);
+
+/*
+ * Static (vocproc) and dynamic (volume) calibration share one payload; the
+ * caller picks V2 or the per-vocoder STATIC/DYNAMIC opcode.
+ */
+struct cvp_register_cal_cmd {
+	struct apr_hdr hdr;
+	u32 cal_mem_handle;
+	u32 cal_mem_address_lsw;
+	u32 cal_mem_address_msw;
+	u32 cal_mem_size;
+	u8 column_info[Q6CVP_MAX_COL_INFO_SIZE];
+} __packed;
+
+int q6cvp_register_cal(struct q6voice_session *cvp, u32 opcode, u32 mem_handle,
+		       u64 addr, u32 size, const u8 *col, size_t col_len)
+{
+	struct cvp_register_cal_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = opcode;
+	cmd.cal_mem_handle = mem_handle;
+	cmd.cal_mem_address_lsw = lower_32_bits(addr);
+	cmd.cal_mem_address_msw = upper_32_bits(addr);
+	cmd.cal_mem_size = size;
+	memcpy(cmd.column_info, col, min_t(size_t, col_len, sizeof(cmd.column_info)));
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_register_cal);
+
+int q6cvp_deregister(struct q6voice_session *cvp, u32 opcode)
+{
+	struct apr_pkt cmd;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = opcode;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_deregister);
+
+/*
+ * Without calibration data loaded the DSP has no volume table to resolve a
+ * step against, so there is no way to know from the source alone what step
+ * value lands on an audible level. Sweepable via a module param instead of
+ * guessing.
+ */
+int q6cvp_set_rx_volume(struct q6voice_session *cvp, u32 step)
+{
+	struct cvp_set_rx_volume_step_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOLUME_CMD_SET_STEP;
+
+	cmd.vol_step.direction = VSS_IVOLUME_DIRECTION_RX;
+	cmd.vol_step.value = step;
+	cmd.vol_step.ramp_duration_ms = 20;
+
+	return q6voice_common_send(cvp, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvp_set_rx_volume);
+
+static int q6cvp_probe(struct apr_device *adev)
+{
+	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVP);
+}
+
+static const struct of_device_id q6cvp_device_id[]  = {
+	{ .compatible = "qcom,q6cvp" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, q6cvp_device_id);
+
+static struct apr_driver qcom_q6cvp_driver = {
+	.probe = q6cvp_probe,
+	.remove = q6voice_common_remove,
+	.callback = q6voice_common_callback,
+	.driver = {
+		.name = "qcom-q6cvp",
+		.of_match_table = of_match_ptr(q6cvp_device_id),
+	},
+};
+
+module_apr_driver(qcom_q6cvp_driver);
+
+MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
+MODULE_DESCRIPTION("Q6 Core Voice Processor");
+MODULE_LICENSE("GPL v2");
diff --git a/sound/soc/qcom/qdsp6/q6cvp.h b/sound/soc/qcom/qdsp6/q6cvp.h
new file mode 100644
index 000000000..99892a825
--- /dev/null
+++ b/sound/soc/qcom/qdsp6/q6cvp.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _Q6_CVP_H
+#define _Q6_CVP_H
+
+#include "q6voice.h"
+
+struct q6voice_session;
+
+struct q6voice_session *q6cvp_session_create(enum q6voice_path_type path,
+					     u16 tx_port, u16 rx_port);
+int q6cvp_enable(struct q6voice_session *cvp, bool enable);
+int q6cvp_set_rx_volume(struct q6voice_session *cvp, u32 step);
+
+/* Vendor vocproc setup: channel info, topology commit, media format, calibration */
+int q6cvp_set_channel_info(struct q6voice_session *cvp, u32 param_id,
+			   u32 num_channels, u32 bits_per_sample, const u8 *map);
+int q6cvp_topology_commit(struct q6voice_session *cvp);
+int q6cvp_set_endpoint_media_format(struct q6voice_session *cvp, u32 param_id,
+				    u32 port_id, u16 num_channels,
+				    u16 bits_per_sample, u32 sample_rate,
+				    const u8 *map);
+int q6cvp_register_dev_cfg(struct q6voice_session *cvp, u32 mem_handle,
+			   u64 addr, u32 size);
+int q6cvp_register_cal(struct q6voice_session *cvp, u32 opcode, u32 mem_handle,
+		       u64 addr, u32 size, const u8 *col, size_t col_len);
+int q6cvp_deregister(struct q6voice_session *cvp, u32 opcode);
+
+#endif /*_Q6_CVP_H */
diff --git a/sound/soc/qcom/qdsp6/q6cvs.c b/sound/soc/qcom/qdsp6/q6cvs.c
new file mode 100644
index 000000000..b5336e1ef
--- /dev/null
+++ b/sound/soc/qcom/qdsp6/q6cvs.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0
+// Copyright (c) 2012-2017, The Linux Foundation. All rights reserved.
+// Copyright (c) 2020, Stephan Gerhold
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/soc/qcom/apr.h>
+#include "q6cvs.h"
+#include "q6voice-common.h"
+
+#define VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION	0x00011140
+
+struct vss_istream_cmd_create_passive_control_session_cmd {
+	struct apr_hdr hdr;
+
+	/* A variable-sized stream name. */
+	char name[20];
+} __packed;
+
+static inline const char *q6cvs_session_name(enum q6voice_path_type path)
+{
+	switch (path) {
+	case Q6VOICE_PATH_VOICE:
+		return q6voice_get_session_name();
+	default:
+		return NULL;
+	}
+}
+
+/*
+ * The stream carries the vocoder: without it the MVM session runs and the
+ * vocproc wires up the ports, but nothing bridges the modem, so the call is
+ * silent.
+ */
+struct q6voice_session *q6cvs_session_create(enum q6voice_path_type path)
+{
+	struct vss_istream_cmd_create_passive_control_session_cmd cmd;
+	const char *session_name;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_ISTREAM_CMD_CREATE_PASSIVE_CONTROL_SESSION;
+
+	session_name = q6cvs_session_name(path);
+	if (session_name)
+		strscpy(cmd.name, session_name, sizeof(cmd.name));
+
+	return q6voice_session_create(Q6VOICE_SERVICE_CVS, path, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_session_create);
+
+#define VSS_IVOLUME_CMD_MUTE_V2		0x0001138B
+#define VSS_IVOLUME_DIRECTION_TX	0
+#define VSS_IVOLUME_DIRECTION_RX	1
+
+struct vss_ivolume_cmd_mute_v2_t {
+	u16 direction;
+	u16 mute_flag;
+	u16 ramp_duration_ms;
+} __packed;
+
+struct cvs_set_mute_cmd {
+	struct apr_hdr hdr;
+	struct vss_ivolume_cmd_mute_v2_t mute;
+} __packed;
+
+int q6cvs_mute(struct q6voice_session *cvs, u16 direction, bool mute)
+{
+	struct cvs_set_mute_cmd cmd;
+
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IVOLUME_CMD_MUTE_V2;
+
+	cmd.mute.direction = direction;
+	cmd.mute.mute_flag = mute;
+	cmd.mute.ramp_duration_ms = 0;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_mute);
+
+#define Q6CVS_MAX_COL_INFO_SIZE		324
+
+/*
+ * VSS_ISTREAM_CMD_REGISTER_CALIBRATION_DATA_V2 and, with per-vocoder
+ * calibration, VSS_ISTREAM_CMD_REGISTER_STATIC_CALIBRATION_DATA: same payload,
+ * the caller picks the opcode.
+ */
+struct cvs_register_cal_cmd {
+	struct apr_hdr hdr;
+	u32 cal_mem_handle;
+	u32 cal_mem_address_lsw;
+	u32 cal_mem_address_msw;
+	u32 cal_mem_size;
+	u8 column_info[Q6CVS_MAX_COL_INFO_SIZE];
+} __packed;
+
+int q6cvs_register_cal(struct q6voice_session *cvs, u32 opcode, u32 mem_handle,
+		       u64 addr, u32 size, const u8 *col, size_t col_len)
+{
+	struct cvs_register_cal_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = opcode;
+	cmd.cal_mem_handle = mem_handle;
+	cmd.cal_mem_address_lsw = lower_32_bits(addr);
+	cmd.cal_mem_address_msw = upper_32_bits(addr);
+	cmd.cal_mem_size = size;
+	memcpy(cmd.column_info, col, min_t(size_t, col_len, sizeof(cmd.column_info)));
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_register_cal);
+
+int q6cvs_deregister_cal(struct q6voice_session *cvs, u32 opcode)
+{
+	struct apr_pkt cmd;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = opcode;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_deregister_cal);
+
+static int q6cvs_probe(struct apr_device *adev)
+{
+	return q6voice_common_probe(adev, Q6VOICE_SERVICE_CVS);
+}
+
+static const struct of_device_id q6cvs_device_id[]  = {
+	{ .compatible = "qcom,q6cvs" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, q6cvs_device_id);
+
+static struct apr_driver qcom_q6cvs_driver = {
+	.probe = q6cvs_probe,
+	.remove = q6voice_common_remove,
+	.callback = q6voice_common_callback,
+	.driver = {
+		.name = "qcom-q6cvs",
+		.of_match_table = of_match_ptr(q6cvs_device_id),
+	},
+};
+
+module_apr_driver(qcom_q6cvs_driver);
+
+MODULE_AUTHOR("Stephan Gerhold <stephan@gerhold.net>");
+MODULE_DESCRIPTION("Q6 Core Voice Stream");
+MODULE_LICENSE("GPL v2");
+
+/*
+ * In-call recording and playback.
+ *
+ * These are what make the call's audio reachable from the CPU at all. On this
+ * SoC the voice path never crosses the CPU - modem to DSP to the physical
+ * ports - so anything that needs the conversation as PCM (a recorder, or
+ * bridging the call to a Bluetooth headset over HCI) has nowhere to tap.
+ *
+ * The DSP can copy the stream to pseudo ports for exactly this: 0x8003 carries
+ * what the far end says, 0x8004 what the microphone picks up, and 0x8005 is an
+ * input mixed into what the far end hears. The vendor stack uses the same
+ * three for call recording and for "in-call music delivery".
+ */
+#define VSS_IRECORD_CMD_START			0x000112BE
+/* Not START+1: the stop opcodes sit in a different range entirely. */
+#define VSS_IRECORD_CMD_STOP			0x00011237
+#define VSS_IRECORD_PORT_ID_DEFAULT		0x0000FFFF
+#define VSS_IRECORD_TAP_POINT_NONE		0x00010F78
+#define VSS_IRECORD_TAP_POINT_STREAM_END	0x00010F79
+#define VSS_IRECORD_MODE_TX_RX_STEREO		0x00010F7A
+#define VSS_IRECORD_MODE_TX_RX_MIXING		0x00010F7B
+
+struct vss_irecord_cmd_start_t {
+	u32 rx_tap_point;
+	u32 tx_tap_point;
+	u16 port_id;
+	u32 mode;
+} __packed;
+
+struct cvs_start_record_cmd {
+	struct apr_hdr hdr;
+	struct vss_irecord_cmd_start_t rec;
+} __packed;
+
+/**
+ * q6cvs_start_record() - start copying the conversation to the record ports
+ * @cvs: the stream session
+ * @rx: tap the downlink (what the far end says) to pseudo port 0x8003
+ * @tx: tap the uplink (the microphone) to pseudo port 0x8004
+ */
+/*
+ * Tapping the uplink has been seen to take the microphone away from the modem
+ * instead of copying it, while the downlink copies cleanly. These let the
+ * port/mode fields be varied at runtime to find out which combination the DSP
+ * expects for a Tx tap; 0 keeps the documented default (per-direction pseudo
+ * ports, mode ignored).
+ */
+static u16 rec_port_id = VSS_IRECORD_PORT_ID_DEFAULT;
+module_param(rec_port_id, ushort, 0644);
+MODULE_PARM_DESC(rec_port_id, "AFE port for in-call record (0xFFFF = per-direction default)");
+
+static uint rec_mode;
+module_param(rec_mode, uint, 0644);
+MODULE_PARM_DESC(rec_mode, "in-call record mode (0 = default, 0x10F7A stereo, 0x10F7B mixing)");
+
+int q6cvs_start_record(struct q6voice_session *cvs, bool rx, bool tx)
+{
+	struct cvs_start_record_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IRECORD_CMD_START;
+
+	cmd.rec.rx_tap_point = rx ? VSS_IRECORD_TAP_POINT_STREAM_END
+				  : VSS_IRECORD_TAP_POINT_NONE;
+	cmd.rec.tx_tap_point = tx ? VSS_IRECORD_TAP_POINT_STREAM_END
+				  : VSS_IRECORD_TAP_POINT_NONE;
+	/*
+	 * The default keeps the two directions on their own pseudo ports;
+	 * naming a port here is only for mixing both into one stereo stream.
+	 */
+	cmd.rec.port_id = rec_port_id;
+	cmd.rec.mode = rec_mode;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_start_record);
+
+int q6cvs_stop_record(struct q6voice_session *cvs)
+{
+	struct apr_hdr hdr = {
+		.pkt_size = sizeof(hdr),
+		.opcode = VSS_IRECORD_CMD_STOP,
+	};
+
+	return q6voice_common_send(cvs, &hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_stop_record);
+
+#define VSS_IPLAYBACK_CMD_START		0x000112BD
+#define VSS_IPLAYBACK_CMD_STOP		0x00011239
+#define VSS_IPLAYBACK_PORT_ID_VOICE	0x00008005
+
+struct vss_iplayback_cmd_start_t {
+	u16 port_id;
+} __packed;
+
+struct cvs_start_playback_cmd {
+	struct apr_hdr hdr;
+	struct vss_iplayback_cmd_start_t play;
+} __packed;
+
+/**
+ * q6cvs_start_playback() - mix audio from pseudo port 0x8005 into the uplink
+ * @cvs: the stream session
+ *
+ * Whatever is written to that port is heard by the far end, which is how a
+ * Bluetooth headset's microphone can reach the call without the DSP ever
+ * talking to the headset itself.
+ */
+int q6cvs_start_playback(struct q6voice_session *cvs)
+{
+	struct cvs_start_playback_cmd cmd;
+
+	memset(&cmd, 0, sizeof(cmd));
+	cmd.hdr.pkt_size = sizeof(cmd);
+	cmd.hdr.opcode = VSS_IPLAYBACK_CMD_START;
+	cmd.play.port_id = VSS_IPLAYBACK_PORT_ID_VOICE;
+
+	return q6voice_common_send(cvs, &cmd.hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_start_playback);
+
+int q6cvs_stop_playback(struct q6voice_session *cvs)
+{
+	struct apr_hdr hdr = {
+		.pkt_size = sizeof(hdr),
+		.opcode = VSS_IPLAYBACK_CMD_STOP,
+	};
+
+	return q6voice_common_send(cvs, &hdr);
+}
+EXPORT_SYMBOL_GPL(q6cvs_stop_playback);
diff --git a/sound/soc/qcom/qdsp6/q6cvs.h b/sound/soc/qcom/qdsp6/q6cvs.h
new file mode 100644
