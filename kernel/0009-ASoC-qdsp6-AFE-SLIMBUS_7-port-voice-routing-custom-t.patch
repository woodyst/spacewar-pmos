Date: Sat, 12 Sep 2026 19:16:03 +0200
Subject: [PATCH 09/13] ASoC: qdsp6: AFE SLIMBUS_7 port, voice routing, custom
 topologies and ADM/ASM changes from surya (r93)

Consolidated from the surya (sm7150) series v7.1_rc3..4c005af83 (patch -F3).
---
 .../sound/qcom,q6dsp-lpass-ports.h            |  23 ++
 sound/soc/qcom/qdsp6/q6adm.c                  |  98 ++++-
 sound/soc/qcom/qdsp6/q6afe-dai.c              |  59 +++
 sound/soc/qcom/qdsp6/q6afe.c                  | 355 ++++++++++++++++-
 sound/soc/qcom/qdsp6/q6afe.h                  |  11 +
 sound/soc/qcom/qdsp6/q6asm-dai.c              |  62 ++-
 sound/soc/qcom/qdsp6/q6asm.c                  |  85 +++-
 sound/soc/qcom/qdsp6/q6core.c                 | 373 ++++++++++++++++++
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.c      |  78 ++++
 sound/soc/qcom/qdsp6/q6dsp-lpass-ports.h      |   1 +
 sound/soc/qcom/qdsp6/q6routing.c              | 172 +++++++-
 11 files changed, 1269 insertions(+), 48 deletions(-)

diff --git a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
index 45850f2d4..62490463e 100644
--- a/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
+++ b/include/dt-bindings/sound/qcom,q6dsp-lpass-ports.h
@@ -153,6 +153,29 @@
 #define SENARY_MI2S_RX		147
 #define SENARY_MI2S_TX		148
 
+/*
+ * SLIMBUS_7 is where the WCN399x Bluetooth chip's SCO ports live. It gets
+ * appended here rather than slotted in after SLIMBUS_6, because these numbers
+ * are device tree ABI and array indices: renumbering everything after it would
+ * silently repoint every existing board's ports.
+ *
+ * The values are not arbitrary. Code infers a port's direction from the parity
+ * of its id - q6slim_set_channel_map() reads a port as TX when (id & 1) - so
+ * RX has to stay even and TX odd. Numbering these 149/150 instead makes the
+ * DSP reject the channel map for the playback port with -EINVAL. 149 is left
+ * unused for that reason.
+ */
+#define SLIMBUS_7_RX		150
+#define SLIMBUS_7_TX		151
+/*
+ * Pseudo ports the DSP uses to make a phone call reachable from the CPU:
+ * the conversation is copied to VOICE_RECORD_{RX,TX}, and anything written to
+ * VOICE_PLAYBACK_TX is mixed into what the far end hears.
+ */
+#define VOICE_RECORD_RX		152
+#define VOICE_RECORD_TX		153
+#define VOICE_PLAYBACK_TX	154
+
 #define LPASS_CLK_ID_PRI_MI2S_IBIT	1
 #define LPASS_CLK_ID_PRI_MI2S_EBIT	2
 #define LPASS_CLK_ID_SEC_MI2S_IBIT	3
diff --git a/sound/soc/qcom/qdsp6/q6adm.c b/sound/soc/qcom/qdsp6/q6adm.c
index db0ae71f2..6eddc2fb3 100644
--- a/sound/soc/qcom/qdsp6/q6adm.c
+++ b/sound/soc/qcom/qdsp6/q6adm.c
@@ -25,6 +25,11 @@
 #define ADM_CMDRSP_DEVICE_OPEN_V5	0x00010329
 #define ADM_CMD_DEVICE_CLOSE_V5		0x00010327
 #define ADM_CMD_MATRIX_MAP_ROUTINGS_V5	0x00010325
+/* The vendor stack opens every COPP with v8; v5 is what mainline has used. */
+#define ADM_CMD_DEVICE_OPEN_V8		0x0001036A
+#define ADM_CMDRSP_DEVICE_OPEN_V8	0x0001036B
+/* No second (or third) endpoint: zero is a valid port id, 0xffff is "none". */
+#define ADM_CMD_COPP_OPEN_END_POINT_ID_IGNORE	0xffff
 
 #define TIMEOUT_MS 1000
 #define RESET_COPP_ID 99
@@ -77,6 +82,26 @@ struct q6adm_cmd_device_open_v5 {
 	u8 dev_channel_mapping[8];
 } __packed;
 
+/*
+ * Same fields as v5 with the topology moved ahead of the endpoints and a third
+ * endpoint added. The factory stack opens every COPP with this one, including
+ * the in-call pseudo ports, and it is the last difference left between the two
+ * command streams once the payload fields are made to match.
+ */
+struct q6adm_cmd_device_open_v8 {
+	u16 flags;
+	u16 mode_of_operation;
+	u32 topology_id;
+	u16 endpoint_id_1;
+	u16 endpoint_id_2;
+	u16 endpoint_id_3;
+	u16 reserved;
+	u16 dev_num_channel;
+	u16 bit_width;
+	u32 sample_rate;
+	u8 dev_channel_mapping[8];
+} __packed;
+
 struct q6adm_cmd_matrix_map_routings_v5 {
 	u32 matrix_id;
 	u32 num_sessions;
@@ -218,6 +243,7 @@ static int q6adm_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 		}
 		switch (result->opcode) {
 		case ADM_CMD_DEVICE_OPEN_V5:
+		case ADM_CMD_DEVICE_OPEN_V8:
 		case ADM_CMD_DEVICE_CLOSE_V5:
 			list_for_each_entry(copp, &adm->copps_list, node) {
 				if ((port_idx == copp->afe_port) && (copp_idx == copp->copp_idx)) {
@@ -239,6 +265,8 @@ static int q6adm_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 		}
 		return 0;
 	}
+	/* v8 answers with its own opcode and the very same payload. */
+	case ADM_CMDRSP_DEVICE_OPEN_V8:
 	case ADM_CMDRSP_DEVICE_OPEN_V5: {
 		struct adm_cmd_rsp_device_open_v5 {
 			u32 status;
@@ -323,21 +351,42 @@ static struct q6copp *q6adm_find_matching_copp(struct q6adm *adm,
 	return ret;
 }
 
+/*
+ * There is no second endpoint on any of the paths we open, and the way to say
+ * so is 0xffff - zero is a perfectly valid port id. The vendor stack always
+ * sends the ignore value; mainline was leaving the field at zero. Under a
+ * parameter so the change can be taken back without a rebuild.
+ */
+
+static bool endpoint2_ignore = true;
+module_param(endpoint2_ignore, bool, 0644);
+MODULE_PARM_DESC(endpoint2_ignore,
+		 "send 0xffff as the ADM second endpoint instead of zero");
+
+static bool device_open_v8 = true;
+module_param(device_open_v8, bool, 0644);
+MODULE_PARM_DESC(device_open_v8,
+		 "open COPPs with ADM_CMD_DEVICE_OPEN_V8 like the vendor stack");
+
 static int q6adm_device_open(struct q6adm *adm, struct q6copp *copp,
 			     int port_id, int path, int topology,
 			     int channel_mode, int bit_width, int rate)
 {
+	struct q6adm_cmd_device_open_v8 *open8;
 	struct q6adm_cmd_device_open_v5 *open;
 	int afe_port = q6afe_get_port_id(port_id);
+	u8 *channel_mapping;
 	struct apr_pkt *pkt;
-	int ret, pkt_size = APR_HDR_SIZE + sizeof(*open);
+	int ret, pkt_size;
+
+	pkt_size = APR_HDR_SIZE + (device_open_v8 ? sizeof(*open8)
+						  : sizeof(*open));
 
 	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
 	if (!p)
 		return -ENOMEM;
 
 	pkt = p;
-	open = p + APR_HDR_SIZE;
 	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
 					   APR_HDR_LEN(APR_HDR_SIZE),
 					   APR_PKT_VER);
@@ -345,21 +394,42 @@ static int q6adm_device_open(struct q6adm *adm, struct q6copp *copp,
 	pkt->hdr.src_port = afe_port;
 	pkt->hdr.dest_port = afe_port;
 	pkt->hdr.token = port_id << 16 | copp->copp_idx;
-	pkt->hdr.opcode = ADM_CMD_DEVICE_OPEN_V5;
-	open->flags = ADM_LEGACY_DEVICE_SESSION;
-	open->mode_of_operation = path;
-	open->endpoint_id_1 = afe_port;
-	open->topology_id = topology;
-	open->dev_num_channel = channel_mode & 0x00FF;
-	open->bit_width = bit_width;
-	open->sample_rate = rate;
-
-	ret = q6dsp_map_channels(&open->dev_channel_mapping[0],
-				 channel_mode);
+
+	if (device_open_v8) {
+		open8 = p + APR_HDR_SIZE;
+		pkt->hdr.opcode = ADM_CMD_DEVICE_OPEN_V8;
+		open8->flags = ADM_LEGACY_DEVICE_SESSION;
+		open8->mode_of_operation = path;
+		open8->topology_id = topology;
+		open8->endpoint_id_1 = afe_port;
+		open8->endpoint_id_2 = ADM_CMD_COPP_OPEN_END_POINT_ID_IGNORE;
+		open8->endpoint_id_3 = ADM_CMD_COPP_OPEN_END_POINT_ID_IGNORE;
+		open8->dev_num_channel = channel_mode & 0x00FF;
+		open8->bit_width = bit_width;
+		open8->sample_rate = rate;
+		channel_mapping = &open8->dev_channel_mapping[0];
+	} else {
+		open = p + APR_HDR_SIZE;
+		pkt->hdr.opcode = ADM_CMD_DEVICE_OPEN_V5;
+		open->flags = ADM_LEGACY_DEVICE_SESSION;
+		open->mode_of_operation = path;
+		open->endpoint_id_1 = afe_port;
+		if (endpoint2_ignore)
+			open->endpoint_id_2 = ADM_CMD_COPP_OPEN_END_POINT_ID_IGNORE;
+		open->topology_id = topology;
+		open->dev_num_channel = channel_mode & 0x00FF;
+		open->bit_width = bit_width;
+		open->sample_rate = rate;
+		channel_mapping = &open->dev_channel_mapping[0];
+	}
+
+	ret = q6dsp_map_channels(channel_mapping, channel_mode);
 	if (ret)
 		return ret;
 
-	return q6adm_apr_send_copp_pkt(adm, copp, pkt, ADM_CMDRSP_DEVICE_OPEN_V5);
+	return q6adm_apr_send_copp_pkt(adm, copp, pkt,
+				       device_open_v8 ? ADM_CMDRSP_DEVICE_OPEN_V8
+						      : ADM_CMDRSP_DEVICE_OPEN_V5);
 }
 
