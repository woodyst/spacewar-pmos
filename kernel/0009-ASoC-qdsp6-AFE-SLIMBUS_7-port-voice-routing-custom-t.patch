+	return 0;
+}
+
 static void q6afe_dai_shutdown(struct snd_pcm_substream *substream,
 				struct snd_soc_dai *dai)
 {
@@ -406,6 +419,9 @@ static int q6afe_dai_prepare(struct snd_pcm_substream *substream,
 					&dai_data->port_config[dai->id].hdmi);
 		break;
 	case SLIMBUS_0_RX ... SLIMBUS_6_TX:
+	/* Not part of the range above: these IDs are appended at the end. */
+	case SLIMBUS_7_RX:
+	case SLIMBUS_7_TX:
 		q6afe_slim_port_prepare(dai_data->port[dai->id],
 					&dai_data->port_config[dai->id].slim);
 		break;
@@ -432,6 +448,11 @@ static int q6afe_dai_prepare(struct snd_pcm_substream *substream,
 		q6afe_usb_port_prepare(dai_data->port[dai->id],
 				       &dai_data->port_config[dai->id].usb_audio);
 		break;
+	case VOICE_RECORD_RX ... VOICE_PLAYBACK_TX:
+		q6afe_pseudo_port_prepare(dai_data->port[dai->id],
+			dai_data->port_config[dai->id].pseudo.num_channels,
+			dai_data->port_config[dai->id].pseudo.sample_rate);
+		break;
 	default:
 		return -EINVAL;
 	}
@@ -527,6 +548,7 @@ static const struct snd_soc_dapm_route q6afe_dapm_routes[] = {
 	{"Slimbus4 Playback", NULL, "SLIMBUS_4_RX"},
 	{"Slimbus5 Playback", NULL, "SLIMBUS_5_RX"},
 	{"Slimbus6 Playback", NULL, "SLIMBUS_6_RX"},
+	{"Slimbus7 Playback", NULL, "SLIMBUS_7_RX"},
 
 	{"SLIMBUS_0_TX", NULL, "Slimbus Capture"},
 	{"SLIMBUS_1_TX", NULL, "Slimbus1 Capture"},
@@ -535,6 +557,10 @@ static const struct snd_soc_dapm_route q6afe_dapm_routes[] = {
 	{"SLIMBUS_4_TX", NULL, "Slimbus4 Capture"},
 	{"SLIMBUS_5_TX", NULL, "Slimbus5 Capture"},
 	{"SLIMBUS_6_TX", NULL, "Slimbus6 Capture"},
+	{"SLIMBUS_7_TX", NULL, "Slimbus7 Capture"},
+	{"VOICE_RECORD_RX", NULL, "Voice Downlink Capture"},
+	{"VOICE_RECORD_TX", NULL, "Voice Uplink Capture"},
+	{"Voice Farend Playback", NULL, "VOICE_PLAYBACK_TX"},
 
 	{"Primary MI2S Playback", NULL, "PRI_MI2S_RX"},
 	{"Secondary MI2S Playback", NULL, "SEC_MI2S_RX"},
@@ -692,6 +718,24 @@ static int msm_dai_q6_dai_remove(struct snd_soc_dai *dai)
 	return 0;
 }
 
+/**
+ * q6afe_dai_get_port() - borrow this DAI's already-owned AFE port
+ *
+ * @dai: DAI to fetch the port for
+ *
+ * Returns the same struct q6afe_port * that msm_dai_q6_dai_probe() opened
+ * and holds for this DAI's entire lifetime (freed only in .remove). Callers
+ * must NOT call q6afe_port_put() on the result - it isn't a new reference,
+ * just a loan of the one this file already owns.
+ */
+struct q6afe_port *q6afe_dai_get_port(struct snd_soc_dai *dai)
+{
+	struct q6afe_dai_data *dai_data = dev_get_drvdata(dai->dev);
+
+	return dai_data->port[dai->id];
+}
+EXPORT_SYMBOL_GPL(q6afe_dai_get_port);
+
 static const struct snd_soc_dai_ops q6afe_usb_ops = {
 	.probe		= msm_dai_q6_dai_probe,
 	.prepare	= q6afe_dai_prepare,
@@ -747,6 +791,14 @@ static const struct snd_soc_dai_ops q6tdm_ops = {
 	.hw_params		= q6tdm_hw_params,
 };
 
+static const struct snd_soc_dai_ops q6pseudo_ops = {
+	.probe		= msm_dai_q6_dai_probe,
+	.remove		= msm_dai_q6_dai_remove,
+	.prepare	= q6afe_dai_prepare,
+	.hw_params	= q6pseudo_hw_params,
+	.shutdown	= q6afe_dai_shutdown,
+};
+
 static const struct snd_soc_dai_ops q6dma_ops = {
 	.probe			= msm_dai_q6_dai_probe,
 	.remove			= msm_dai_q6_dai_remove,
@@ -766,6 +818,7 @@ static const struct snd_soc_dapm_widget q6afe_dai_widgets[] = {
 	SND_SOC_DAPM_AIF_IN("SLIMBUS_4_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("SLIMBUS_5_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("SLIMBUS_6_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_IN("SLIMBUS_7_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("SLIMBUS_0_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("SLIMBUS_1_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("SLIMBUS_2_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
@@ -773,6 +826,11 @@ static const struct snd_soc_dapm_widget q6afe_dai_widgets[] = {
 	SND_SOC_DAPM_AIF_OUT("SLIMBUS_4_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("SLIMBUS_5_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("SLIMBUS_6_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_OUT("SLIMBUS_7_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
+	/* The DSP's copy of a call: two taps out, one injection in. */
+	SND_SOC_DAPM_AIF_OUT("VOICE_RECORD_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_OUT("VOICE_RECORD_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
+	SND_SOC_DAPM_AIF_IN("VOICE_PLAYBACK_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("SEN_MI2S_RX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("SEN_MI2S_TX", NULL, 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_IN("QUIN_MI2S_RX", NULL,
@@ -1127,6 +1185,7 @@ static int q6afe_dai_dev_probe(struct platform_device *pdev)
 	cfg.q6tdm_ops = &q6tdm_ops;
 	cfg.q6dma_ops = &q6dma_ops;
 	cfg.q6usb_ops = &q6afe_usb_ops;
+	cfg.q6pseudo_ops = &q6pseudo_ops;
 	dais = q6dsp_audio_ports_set_config(dev, &cfg, &num_dais);
 
 	return devm_snd_soc_register_component(dev, &q6afe_dai_component, dais, num_dais);
diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index 28b5b6b91..bf3228e09 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -28,6 +28,33 @@
 #define AFE_PORT_CMD_DEVICE_START	0x000100E5
 #define AFE_PORT_CMD_DEVICE_STOP	0x000100E6
 #define AFE_PORT_CMD_SET_PARAM_V2	0x000100EF
+#define AFE_PORT_CMD_SET_PARAM_V3	0x000100FA
+
+/*
+ * Which version of the port parameter command to use, and how much of the
+ * pseudo port configuration to send. The vendor uses v3 for everything and
+ * sends 204 bytes of configuration for the pseudo ports - the whole union -
+ * where we send only the 16 bytes the structure actually needs.
+ */
+static bool set_param_v3 = true;
+module_param(set_param_v3, bool, 0644);
+MODULE_PARM_DESC(set_param_v3, "send port parameters with command v3 (vendor) instead of v2");
+
+/*
+ * How much the vendor sends as the pseudo port configuration: its own port
+ * config union, 204 bytes, of which only the first 16 are the pseudo port
+ * structure and the rest is zeroes. Ours is smaller, so to send the same
+ * amount the payload has to be padded out to the vendor's size.
+ */
+#define AFE_VENDOR_PORT_CFG_SIZE	204
+
+static bool pseudo_cfg_full = true;
+module_param(pseudo_cfg_full, bool, 0644);
+MODULE_PARM_DESC(pseudo_cfg_full, "send the whole config union for pseudo ports, as the vendor does");
+
+static bool pseudo_cfg_last = true;
+module_param(pseudo_cfg_last, bool, 0644);
+MODULE_PARM_DESC(pseudo_cfg_last, "send the pseudo port config after topology and delay, as the vendor does");
 #define AFE_SVC_CMD_SET_PARAM		0x000100f3
 #define AFE_PORT_CMDRSP_GET_PARAM_V2	0x00010106
 #define AFE_PARAM_ID_HDMI_CONFIG	0x00010210
@@ -120,6 +147,19 @@
 #define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_6_RX      0x400c
 /* SLIMbus Tx port on channel 6. */
 #define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_6_TX      0x400d
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_RX      0x400e
+#define AFE_PORT_ID_SLIMBUS_MULTI_CHAN_7_TX      0x400f
+/*
+ * Pseudo ports. They have no hardware behind them: the DSP copies the voice
+ * stream into 0x8003/0x8004 so the CPU can read the call, and mixes whatever
+ * arrives on 0x8005 into the uplink. Despite that, they are configured and
+ * started like any other port (AFE_PARAM_ID_PSEUDO_PORT_CONFIG plus the usual
+ * device start); the dedicated AFE_PSEUDOPORT_CMD_START has no callers in the
+ * vendor stack.
+ */
+#define AFE_PORT_ID_VOICE_RECORD_RX              0x8003
+#define AFE_PORT_ID_VOICE_RECORD_TX              0x8004
+#define AFE_PORT_ID_VOICE_PLAYBACK_TX            0x8005
 #define AFE_PORT_ID_PRIMARY_MI2S_RX         0x1000
 #define AFE_PORT_ID_PRIMARY_MI2S_TX         0x1001
 #define AFE_PORT_ID_SECONDARY_MI2S_RX       0x1002
@@ -418,6 +458,28 @@ struct afe_port_cmd_set_param_v2 {
 	u32 mem_map_handle;
 } __packed;
 
+/*
+ * The vendor sends its port parameters with v3 of the command: the port id and
+ * the memory header are laid out differently and each parameter carries an
+ * instance id. Its traces show v3 for every port, ours have always used v2.
+ */
+struct afe_port_cmd_set_param_v3 {
+	u16 port_id;
+	u16 reserved;
+	u32 payload_address_lsw;
+	u32 payload_address_msw;
+	u32 mem_map_handle;
+	u32 payload_size;
+} __packed;
+
+struct afe_port_param_data_v3 {
+	u32 module_id;
+	u16 instance_id;
+	u16 reserved;
+	u32 param_id;
+	u32 param_size;
+} __packed;
+
 struct afe_param_id_hdmi_multi_chan_audio_cfg {
 	u32 hdmi_cfg_minor_version;
 	u16 datatype;
@@ -606,6 +668,19 @@ struct afe_param_id_usb_audio_svc_interval {
 	u32	svc_interval;
 } __packed;
 
+#define AFE_PARAM_ID_PSEUDO_PORT_CONFIG	0x00010219
+#define AFE_API_VERSION_PSEUDO_PORT_CONFIG	0x1
+#define AFE_PSEUDOPORT_TIMING_MODE_TIMER	0x1
+
+struct afe_param_id_pseudo_port_cfg {
+	u32	cfg_minor_version;
+	u16	bit_width;
+	u16	num_channels;
+	u16	data_format;	/* 0 = linear PCM */
+	u16	timing_mode;
+	u32	sample_rate;
+} __packed;
+
 union afe_port_config {
 	struct afe_param_id_hdmi_multi_chan_audio_cfg hdmi_multi_ch;
