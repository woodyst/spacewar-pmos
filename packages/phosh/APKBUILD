dbd7a75bef547d639d84e851a67d36b1d9746413cf059a0757e8536157a73253d696c4ddde5b17083807099744e55ddd6542dadd77af559b0ea89090419814b5  0001-complemento-de-ajustes-rapidos-por-mandato.patch
5eb4402b0d7ea5720b473183cb503118f6cda865a8b23692d65aa46c87a783613d0fb0715a2a9c68df730c933b33b949e0c453b23bffc7b91e0e761514daecb5  0002-despertar-automatico-no-enciende-la-pantalla.patch
