cb4bad612e5d2dff156c6b97b460c16ab7fd48067935b616fe0b65d11c3d255f1ecd06b800c654ac9ea93bc53e823eb47134836dfdf61bb338588dab78d3b9e9  splash-timeout-flatpak-dbus.patch
2377606ea31c3ee2a4bf766fed0c51cbf248b1fa03f08a11c4b8ec2fe78dcc5668161d83588e67f0b08b0ed1a145a4ca45308df6a9d97c076b5ef271175ec313  0001-complemento-de-ajustes-rapidos-por-mandato.patch
"
