# Contributor: Krassy Boykinov <kboykinov@teamcentrixx.com>
maintainer="Krassy Boykinov <kboykinov@teamcentrixx.com>"
pkgname=flare
pkgver=0.22.2
# spacewar (2026-10-05): receta de Alpine community/flare (0.20.4-r0) subida a 0.22.2 desde el git del proyecto.
# La 0.20.4 que sirve el repositorio NO funciona (Signal cambió la API: la app no conecta); la que va es la actual.
# pkgrel=100: que una recompilación de Alpine (r1..r99) no pise la nuestra en un `apk upgrade`; una versión nueva
# del programa (0.23…) sí -> 48-flare.sh --ver. Los dos parches son los de Alpine, revalidados sobre 0.22.2.
pkgrel=100
pkgdesc="Unofficial Signal GTK client"
url="https://gitlab.com/schmiddi-on-mobile/flare"
arch="all"
license="AGPL-3.0-only"
makedepends="
	blueprint-compiler
	cargo-auditable
	desktop-file-utils
	gettext-dev
	gtk4.0-dev
	gtksourceview5-dev
	libadwaita-dev
	libsecret-dev
	libspelling-dev
	meson
	openssl-dev
	protobuf-dev
	"
subpackages="$pkgname-lang"
source="https://gitlab.com/schmiddi-on-mobile/flare/-/archive/$pkgver/flare-$pkgver.tar.gz
	0001-no-cargo-home.patch
	0002-use-cargo-auditable.patch
	"
# no tests
options="!check net"


prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

