+/*
+ * Build the control map handed to the IPA: the sensor's with the focus lens'
+ * merged in. It is rebuilt on configure() because the lens is only known to
+ * the pipeline handler by then, and without it the autofocus algorithm cannot
+ * see the actuator.
+ */
+void SoftwareIsp::buildIpaSensorControls()
+{
+	ControlInfoMap::Map merged(sensor_->controls().begin(),
+				   sensor_->controls().end());
+	ipaSensorIdMap_ = sensor_->controls().idmap();
+
+	CameraLens *lens = focusLens_ ? focusLens_ : sensor_->focusLens();
+	if (lens) {
+		for (const auto &[id, info] : lens->controls())
+			merged[id] = info;
+		/*
+		 * The id map has to grow too: ControlInfoMap asserts that every
+		 * control it holds is described there.
+		 */
+		for (const auto &[num, id] : lens->controls().idmap())
+			ipaSensorIdMap_[num] = id;
+	}
+
+	ipaSensorControls_ = ControlInfoMap(std::move(merged), ipaSensorIdMap_);
+
+	LOG(SoftwareIsp, Debug)
+		<< "IPA sensor controls: " << ipaSensorControls_.size()
+		<< " (lens " << (lens ? lens->controls().size() : 0) << ", "
+		<< (ipaSensorControls_.find(V4L2_CID_FOCUS_ABSOLUTE) != ipaSensorControls_.end()
+			    ? "with focus" : "NO focus")
+		<< ")";
+}
