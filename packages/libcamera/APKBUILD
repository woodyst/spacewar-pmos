# Forked from Alpine for temporary downstream patches
# spacewar (2026-09-14): receta temp/libcamera de pmaports + 0009 (enfoque manual para las apps) y 0010
# (autoenfoque por contraste en el IPA simple), traídos de surya. Compila scripts/94-libcamera.sh.
# 0011 (2026-09-14): el objetivo solo se abre (y el motor de enfoque solo se alimenta) mientras una app tiene la
# cámara adquirida; antes el monitor de libcamera de WirePlumber dejaba los dos motores encendidos siempre.
# 0012: ELIMINADO el 2026-11-22 — 0.8 ya usa /dev/udmabuf antes que la CMA
#       (DmaBufAllocatorFlag::UDmaBuf en el constructor del ISP).
# 0013 (2026-09-14): el debayer EGL destruye su contexto al parar; antes cada sesión dejaba un contexto huérfano
# con un búfer de salida de 8 MB retenido en la GPU.
maintainer="Robert Mader <robert.mader@collabora.com>"
pkgname=libcamera
_pkgver=0.8.0
pkgver=9999$_pkgver
# spacewar (2026-11-22): libcamera 0.8.0 — la que pide pipewire-spa-libcamera 1.6.11 — con los
# parches nuestros que aplican. pkgrel alto para que una actualización del repositorio no la sustituya.
# Los que NO están (0003/0005/0006 ya upstream; 0007/0008 los trae ya el aporte de pmOS;
# 0004/0010/0013 pendientes de portar a la refactorización del softISP de 0.8.0).
pkgrel=100
pkgdesc="Linux camera framework"
url="https://libcamera.org/"
arch="all"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
# upstream calls 'date' with a non-POSIX option so we pull in coreutils
makedepends="
	coreutils
	doxygen
	eudev-dev
	glib-dev
	gnutls-dev
	graphviz
	gst-plugins-base-dev
	gtest-dev
	libevent-dev
	libpisp-dev
	libunwind-dev
	libyuv-dev
	linux-headers
	meson
	py3-jinja2
	py3-ply
	py3-pybind11-dev
	py3-sphinx
	py3-sphinxcontrib-doxylink
	py3-yaml
	python3-dev
	qt6-qtbase-dev
	qt6-qttools-dev
	yaml-dev
	"
subpackages="
	$pkgname-dbg
	$pkgname-dev
	qcam
	$pkgname-gstreamer
	$pkgname-v4l2
	$pkgname-tools
	py3-$pkgname-pyc:pyc
	py3-$pkgname:py3
	"
_tuning_files="
	hi846.yaml
	imx355.yaml
	imx363.yaml
	imx371.yaml
	imx376.yaml
	imx519.yaml
	imx800.yaml
	imx858.yaml
	s5k3l6xx.yaml
	s5kjn1.yaml
	"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$_pkgver/libcamera-v$_pkgver.tar.gz
	0001-libcamera-simple-Enable-softISP-for-the-Pinephone.patch
	0002-libcamera-simple-Skip-hwISP-formats-if-swISP-is-acti.patch
	0009-libcamera-simple-conducir-la-lente-y-el-autoenfoque.patch
	0010-libcamera-softisp-contraste-para-el-autoenfoque.patch
	0011-libcamera-camera_lens-Power-the-lens-only-while-the-c.patch
	0012-libcamera-usar-udmabuf-antes-que-la-cma.patch
	0013-libcamera-py-crear-el-dir-antes-de-los-enlaces.patch
	0014-libcamera-helpers-de-sensor-s5kjn1-e-imx766.patch
	$_tuning_files
"
builddir="$srcdir/$pkgname-v$_pkgver"
# gstreamer tests fail
# manual strip because ipa .sign files depend on the file contents- have to re-sign after strip
options="!strip !check"

case "$CARCH" in
arm*|aarch64)
	subpackages="$subpackages $pkgname-raspberrypi"
	;;
esac

case "$CARCH" in
ppc64le|s390x|riscv64|loongarch64)
	# doesn't install any ipa
	;;
*)
	depends="$pkgname-ipa=$pkgver-r$pkgrel"
	subpackages="$subpackages $pkgname-ipa"
	;;
esac

build() {
	# ⚠️ 0.8 (2026-11-22): src/py/libcamera/meson.build ejecuta `ln -fsrT` al configurar y el `ln` de
	# busybox no tiene ni -r ni -T, así que la configuración muere con
	# «Command `/usr/sbin/ln -fsrT ...` failed». Se le pone delante un `ln` que sí los tiene (coreutils),
	# sin depender de en qué directorio caiga cada uno en el chroot.
	_lnbin="$srcdir/.ln-coreutils"; mkdir -p "$_lnbin"
	_core=/usr/bin/coreutils; [ -x "$_core" ] || _core=/bin/coreutils
	# ⚠️ tiene que ser un ENLACE llamado «ln», no un guion que llame a `coreutils ln`: el binario
	# multiplexor de coreutils decide el applet por argv[0] y con `coreutils ln -fsrT` responde
	# «invalid option -- 'f'» (probado el 2026-11-22).
	ln -sf "$_core" "$_lnbin/ln"
	export PATH="$_lnbin:$PATH"
	abuild-meson \
		-Dpipelines=auto,virtual \
		-Dv4l2=true \
		-Dwerror=false \
		-Ddocumentation=disabled \
		. output
	meson compile -C output
}

check() {
	meson test -C output --print-errorlogs
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	# manual strip first..
	scanelf --recursive \
		--nobanner \
		--etype "ET_DYN,ET_EXEC" \
		--format "%F" \
		"$pkgdir" \
		| while read -r file; do
			strip "$file"
	done
}

ipa() {
	depends=""
	amove usr/lib/libcamera
	amove usr/share/libcamera/ipa

	for _tuning_file in $_tuning_files; do
		# ⚠️ 0.8 cambió la carpeta: el IPA «softisp» busca en ipa/softisp, no en ipa/simple
		# (2026-11-22: sin esto libcamera decía «Configuration file 's5kjn1.yaml' not found» y se
		# quedaba con la calibración genérica: color raro y sin el «- Af:» del sensor).
		install -Dm644 -t "$subpkgdir"/usr/share/libcamera/ipa/softisp \
			"$srcdir"/"$_tuning_file"
	done

	# then sign ipa's
	local ipa
	for ipa in "$subpkgdir"/usr/lib/libcamera/ipa/ipa*.so; do
		msg "signing $ipa"
		"$builddir"/src/ipa/ipa-sign.sh \
			"$(find "$builddir"/output -type f -iname "*ipa-priv-key.pem")" \
			"$ipa" \
			"$ipa".sign
	done
}

qcam() {
	depends=""
	amove usr/bin/qcam

}

gstreamer() {
	depends=""
	amove usr/lib/gstreamer-1.0
}

v4l2() {
	depends=""
	amove usr/libexec/libcamera/v4l2-compat.so
}

raspberrypi() {
	depends=""
	amove usr/share/libcamera/ipa/rpi
	amove usr/libexec/libcamera/raspberrypi_ipa_proxy
	amove usr/share/libcamera/pipeline/rpi/vc4
}

tools() {
	depends=""
	amove usr/bin/cam
	amove usr/bin/lc-compliance
}

py3() {
	pkgdesc="$pkgname (python bindings)"
	depends="python3"

	amove usr/lib/python*
}


