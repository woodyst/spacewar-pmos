+	/*
+	 * Set up the focus lens. The sensor exposes it only when the kernel links
+	 * it as an ancillary entity; when it is a plain entity of the media device
+	 * it has to be created here, or the lens can never be driven and
+	 * autofocus stays disabled.
+	 */
+	focusLens_ = sensor_->focusLens();
+	if (!focusLens_) {
+		/*
+		 * ⚠️ Solo si hay UNA lente en el dispositivo de medios: con varias cámaras,
+		 * quedarse con la primera que aparezca le da a este sensor el actuador de otra
+		 * (medido el 2026-11-22: la trasera-1 recibía el ak7375 de la principal, con otro
+		 * rango de recorrido). Sin enlace en el grafo y con varias lentes, mejor no tocar
+		 * ninguna.
+		 */
+		const MediaEntity *unica = nullptr;
+		unsigned int lentes = 0;
+		for (const MediaEntity *entity : sensor_->entity()->device()->entities()) {
+			if (entity->function() != MEDIA_ENT_F_LENS)
+				continue;
+			unica = entity;
+			lentes++;
+		}
+
+		if (lentes == 1) {
+			lens_ = std::make_unique<CameraLens>(unica);
+			if (lens_->init()) {
+				LOG(SimplePipeline, Warning)
+					<< "Lens " << unica->name() << " initialisation failed";
+				lens_.reset();
+			} else {
+				focusLens_ = lens_.get();
+				LOG(SimplePipeline, Debug) << "Using lens " << unica->name();
+			}
+		} else if (lentes > 1) {
+			LOG(SimplePipeline, Debug)
+				<< "Several lenses in the media device and none linked to the sensor: "
+				<< "not driving any";
+		}
+	}
+
+	if (focusLens_ && swIsp_)
+		swIsp_->setFocusLens(focusLens_);
+
 	video_ = pipe->video(entities_.back().entity);
 	ASSERT(video_);
 
