+/*
+ * Pick the Speaker/Earpiece variant of the currently active Voice Call
+ * profile and switch to it. Cards with a dedicated voice profile (e.g.
+ * surya) route Speaker/Earpiece as separate card profiles with no sinks of
+ * their own rather than as ports on a shared sink, so set_output_port()
+ * (which needs a sink) cannot be used for them - see cad_pulse_enable_speaker().
+ */
+static void set_voicecall_profile_for_speaker(pa_context *ctx, const pa_card_info *info, int eol, void *data)
+{
+    CadPulseOperation *operation = data;
+    pa_card_profile_info2 *profile;
+    pa_operation *op = NULL;
+    const char *target_profile = NULL;
+    uint32_t target_priority = 0;
+
+    if (eol != 0)
+        return;
+
+    if (!info) {
+        g_critical("PA returned no card info (eol=%d)", eol);
+        return;
+    }
+
+    if (info->index != operation->pulse->card_id)
+        return;
+
+    for (int i = 0; i < info->n_profiles; i++) {
+        profile = info->profiles2[i];
+
+        if (!profile->available || !g_str_has_prefix(profile->name, SND_USE_CASE_VERB_VOICECALL))
+            continue;
+
+        /*
+         * When enabling the speaker, only the speaker variant will do. When
+         * disabling it, take the highest-priority non-speaker variant (the
+         * earpiece, or headphones/handsfree if the card ever exposes one as
+         * a higher-priority voice profile) - same intent as
+         * get_available_sink_port()'s port-based equivalent.
+         */
+        if (operation->value) {
+            if (!g_strrstr(profile->name, "Speaker"))
+                continue;
+        } else if (g_strrstr(profile->name, "Speaker")) {
+            continue;
+        }
+
+        /*
+         * Turning the speaker off goes back to the headset when there is
+         * one, and to the earpiece otherwise. Same reason as in
+         * set_card_profile(): the headset profile carries the lowest
+         * priority precisely so that only code that knows about the headset
+         * ever selects it.
+         */
+        if (profile_is_bt(profile->name)) {
+            if (operation->pulse->has_bt_headset) {
+                target_profile = profile->name;
+                break;
+            }
+            continue;
+        }
+
+        if (profile->priority > target_priority) {
+            target_profile = profile->name;
+            target_priority = profile->priority;
+        }
+    }
+
+
+
+    if (target_profile) {
+        if (g_strcmp0(info->active_profile2->name, target_profile) != 0) {
+            g_debug("switching to voice call profile '%s'", target_profile);
+            op = pa_context_set_card_profile_by_index(ctx, operation->pulse->card_id,
+                                                      target_profile,
+                                                      operation_complete_cb, operation);
+        }
+    } else if (operation->pulse->sink_id >= 0) {
+        /*
+         * The card has a voice profile, but not one per output: it keeps the
+         * speaker and the earpiece as ports of a single sink. Switch the port
+         * instead, which is what such a card expects.
+         */
+        g_debug("no per-output voice call profile, switching port instead");
+        op = pa_context_get_sink_info_by_index(ctx, operation->pulse->sink_id,
+                                               set_output_port, operation);
+    }
+
+    if (op) {
+        pa_operation_unref(op);
+    } else {
+        g_debug("%s: nothing to be done", __func__);
+        operation_complete_cb(ctx, 1, operation);
+    }
+}
