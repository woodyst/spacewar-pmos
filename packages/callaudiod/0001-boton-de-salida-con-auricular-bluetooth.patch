-    if (operation->pulse->sink_id < 0) {
+    if (operation->pulse->has_voice_profile) {
+        /*
+         * A card with a dedicated voice profile may express the speaker and
+         * the earpiece as separate profiles of the voice verb rather than as
+         * ports of one sink - surya does, so that each output can carry its
+         * own volume control. Look for such a profile first;
+         * set_voicecall_profile_for_speaker() falls back to switching the
+         * port if the card turns out not to have one.
+         */
+        op = pa_context_get_card_info_by_index(operation->pulse->ctx,
+                                               operation->pulse->card_id,
+                                               set_voicecall_profile_for_speaker, operation);
+    } else if (operation->pulse->sink_id >= 0) {
+        op = pa_context_get_sink_info_by_index(operation->pulse->ctx,
+                                               operation->pulse->sink_id,
+                                               set_output_port, operation);
+    } else {
         g_warning("card has no usable sink");
         goto error;
     }
