+/*
+ * The SCO link is NOT taken here.
+ *
+ * The chip only routes call audio onto its bus while a SCO link exists, and
+ * the link has to be up *before* the routing is applied: the DSP opens its
+ * side when the mixer controls land, and if the chip's SCO ports are still
+ * asleep at that moment nothing moves afterwards. Measured: with the link
+ * taken first the far end hears the headset perfectly; taken at the same
+ * time as the routing, both directions stay silent with every log looking
+ * correct.
+ *
+ * callaudiod only ever hears about the speaker button, which is far too
+ * late. So a small service watching ModemManager takes the link as soon as a
+ * call starts (scripts/llamada-al-bluetooth.sh), and by the time wireplumber
+ * picks the Voice Call profile the link is already up.
+ */
+
+/*
+ * Whether this profile is the headset one, and whether it may be used.
+ */
+static gboolean profile_is_bt(const char *name)
+{
+    return g_strrstr(name, VOICECALL_BT_DEVICE) != NULL;
+}
+
+/*
+ * Take or release the SCO link according to where the call is actually
+ * routed, whoever moved it.
+ *
+ * The profile at the start of a call is not chosen here: wireplumber's
+ * find-voice-call-profile.lua does it, and callaudiod only hears about the
+ * speaker button. So instead of acting on our own decisions, watch the card's
+ * active profile and follow it.
+ */
+static void watch_profile_cb(pa_context *ctx, const pa_card_info *info,
+                             int eol, void *data)
+{
+    CadPulse *self = data;
+
+    if (eol != 0 || !info || info->index != (uint32_t)self->card_id)
+        return;
+    if (!info->active_profile2)
+        return;
+
+    if (profile_is_bt(info->active_profile2->name))
+        g_debug("the call is on the headset");
+}
