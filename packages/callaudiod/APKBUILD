e822f05077e5460a18d8583f9d19ca80160bca79782b0d6f6284e371190009179c9afb5f34d758f849adf2ae7e308d6da00f365f731503d69b5a2a243b112296  0001-boton-de-salida-con-auricular-bluetooth.patch
"
