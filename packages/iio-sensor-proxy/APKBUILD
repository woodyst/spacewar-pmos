# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=iio-sensor-proxy
pkgver=3.9
# spacewar (2026-09-21): la receta de Alpine (3.9-r2) + 0001, que difunde a todo el bus los cambios de
# disponibilidad (Has*). Sin él, phosh se queda sin rotación automática en cada arranque: pregunta a los ~26 s,
# el acelerómetro del ADSP aparece a los ~86 s y el aviso solo iba a quien ya lo hubiera reclamado.
# r100: que una recompilación de Alpine (r3..r99) no pise el parche; una 3.10 sí -> verificar-instalado.sh.
pkgrel=100
pkgdesc="IIO sensors to D-Bus proxy"
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
arch="all"
license="GPL-2.0-or-later"
depends="dbus"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	meson
	polkit-dev
	libssc-dev
	"
subpackages="$pkgname-openrc $pkgname-systemd $pkgname-udev $pkgname-dbg"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	iio-sensor-proxy.initd
	0001-difundir-los-cambios-de-disponibilidad-de-los-sensores.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}

sha512sums="
