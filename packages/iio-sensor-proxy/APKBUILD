b25df94e249ca46fe96926e5a866c20dc913fa52a2d9259fb7a3594861c6b2f246fc7fef8a21f5b021f3a71401f734ae27210137b0b1917a7daaffb5e3221f2e  iio-sensor-proxy.initd
a4a4ff974c2d88aa792aa325c25a930f01401ebde40ae2ab32a446d8d5e5723c432250c019a2c8b42761e51c8304996c9e578b8770212eff3b7229d0c00ded53  0001-difundir-los-cambios-de-disponibilidad-de-los-sensores.patch
"
