8ce7e461a5824583f607d665c4bf00497872a3de95897ff93da7ea4cc12486a086cd0ad7cef1d077b0ea2b8c13e5cd785532a5687f3d16afe09a5bdfea22a490  0001-contact-sheet-llamar-desde-ficha-y-estrella-favorito.patch
"
