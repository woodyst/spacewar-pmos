a7c97f986a840c803239322f69dec6df6586a19b1e7d9ca11cff6a0b47861ab1d68263318b6ab93452d6526543428f6ced9617edbadd0c902c7e9767727c5c76  emoji-db.patch
a3f5232413de06e4010da4434a4fdc55b77a385e66544587571589758216d6357cdf1356090dd83ddaf5d9556967b986e2c4682147262511e1a19834dc863e47  0001-shortcuts-bar-dibujar-shift-tab.patch
"
