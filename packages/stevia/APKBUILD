# Contributor: jane400 <alpine@j4ne.de>
maintainer="team/phosh <newbyte@postmarketos.org>"
pkgname=stevia
pkgver=0.57.0
# spacewar (2026-09-21): la receta de Alpine edge (0.57.0-r2) + 0001, que dibuja Shift+Tab en la fila de atajos.
# r100: que una recompilación de Alpine (r3..r99) no pise el parche en un `apk upgrade`; una 0.58 sí -> 44-stevia.sh --ver.
pkgrel=100
pkgdesc="Alternative OSK for phosh"
arch="all !riscv64" # tests fail with SIGSEGV
url="https://gitlab.gnome.org/World/Phosh/stevia"
license="GPL-3.0-or-later"
depends="hunspell-en-us"
makedepends="
	py3-docutils
	dconf-dev
	elogind-dev
	feedbackd-dev
	fzf
	glib-dev
	gmobile-dev
	gnome-desktop-dev
	gtk+3.0-dev
	hunspell-dev
	json-glib-dev
	libhandy1-dev
	meson
	presage-dev
	wayland-dev
	wayland-protocols
	uim-dev
	"
checkdepends="xvfb-run words-en"
subpackages="
	$pkgname-dbg
	$pkgname-doc
	$pkgname-lang
	$pkgname-schemas
	$pkgname-systemd
	"
source="https://gitlab.gnome.org/World/Phosh/stevia/-/archive/v$pkgver/stevia-v$pkgver.tar.gz
	emoji-db.patch
	0001-shortcuts-bar-dibujar-shift-tab.patch
	"
builddir="$srcdir/stevia-v$pkgver"
options="!check" # las pruebas necesitan xvfb; en el chroot cruzado no hay

provides="phosh-keyboard=0 phosh-osk-stub=$pkgver-r$pkgrel"
provider_priority=1
replaces="phosh"

case "$CARCH" in
armhf|armv7) ;; # doesnt have community/uim
*) makedepends="$makedepends uim-dev"
esac

build() {
	abuild-meson \
		-Db_lto=true \
		-Dman=true \
		-Dwordlist=/usr/share/dict/american-english \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}

